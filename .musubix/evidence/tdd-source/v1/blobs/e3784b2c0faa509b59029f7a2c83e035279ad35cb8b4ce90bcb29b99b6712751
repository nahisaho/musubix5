  /** @id TEST-M5-FINALIZATION-FENCED-001
   * @verifies REQ-M5-MULTI-CHANGE-004 REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-003 DES-M5-MULTI-CHANGE-008
   */
  it('TEST-M5-FINALIZATION-FENCED-001 forbids fenced marker cleanup and reruns pre-CAS finalization in the same authorized resume', async () => {
    for (const boundary of ['before-marker', 'after-marker']) {
      const { root, firstId, secondId, baseCommit } = await createFixture();
      const module = await import('../packages/analysis/src/candidate-integration.js');
      const verified = await module.orchestrateCandidateIntegration({
        controlRoot: root, selectors: [firstId, secondId], verify: async () => verification,
      });
      const markerPath = resolve(root, '.git/musubix5/finalizations', `${verified.integrationId.slice(12)}.json`);
      const expire = (leases: journal.ChangeProjectionAppendLeaseSet) => {
        const ownerPath = resolve(leases.projectionLease.path, 'owner.json');
        const owner = JSON.parse(readFileSync(ownerPath, 'utf8'));
        writeFileSync(ownerPath, JSON.stringify({ ...owner, expiresAt: 0 }));
      };
      const original = journal.assertLeaseSetCurrent;
      const spy = vi.spyOn(journal, 'assertLeaseSetCurrent').mockImplementation(async (...args) => {
        if (boundary === 'after-marker' && existsSync(markerPath)) expire(args[0]);
        return original(...args);
      });
      const input = {
        controlRoot: root, integrationId: verified.integrationId,
        recoverBatchCheckpoints: async (path: string, id: string, leases: journal.ChangeProjectionAppendLeaseSet) => {
          if (boundary === 'before-marker') expire(leases);
          return recoverBatchCheckpoints(path, id, leases);
        },
      };
      await expect(module.finalizeCandidateIntegration(input)).rejects.toThrow('LEASE_FENCED');
      spy.mockRestore();
      expect(git(root, 'rev-parse', 'main')).toBe(baseCommit);
      expect(existsSync(markerPath)).toBe(boundary === 'after-marker');
      expect((await journal.loadJournalRecords(root)).some((record) => record.kind === 'candidate-integration-integrated')).toBe(false);
      const oldContext = (await journal.loadJournalRecords(root))
        .filter((record) => record.kind === 'candidate-finalization-lease-context')[0]!;
      const resumeInput = { ...input, recoverBatchCheckpoints };
      const result = await module.finalizeCandidateIntegration(resumeInput);
      expect(result.state).toBe('integrated');
      expect(existsSync(markerPath)).toBe(false);
      expect(git(root, 'rev-parse', 'main')).toBe(result.integrationCommit);
      const contexts = (await journal.loadJournalRecords(root))
        .filter((record) => record.kind === 'candidate-finalization-lease-context');
      expect(contexts).toHaveLength(2);
      expect(contexts[0]).toEqual(oldContext);
      expect(contexts[1]!.idempotencyKey).not.toBe(contexts[0]!.idempotencyKey);
    }
  });

  /** @id TEST-M5-FINALIZATION-JOURNAL-001
   * @verifies REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-002 DES-M5-MULTI-CHANGE-003 DES-M5-MULTI-CHANGE-008
   */
  it('TEST-M5-FINALIZATION-JOURNAL-001 journals each scope before selected recovery and rejects malformed later context instead of falling back', async () => {
    const { root, firstId, secondId, baseCommit } = await createFixture();
    const module = await import('../packages/analysis/src/candidate-integration.js');
    const verified = await module.orchestrateCandidateIntegration({
      controlRoot: root, selectors: [firstId, secondId], verify: async () => verification,
    });
    const keys: string[] = [];
    const recovery = vi.fn(async (_root: string, _id: string, leases: journal.ChangeProjectionAppendLeaseSet) => {
      await journal.assertLeaseSetCurrent(leases);
      expect(leases.appendSession).toBeDefined();
      const records = await journal.loadJournalRecords(root);
      const context = records.filter((record) => record.kind === 'candidate-finalization-lease-context').at(-1)!;
      expect(context).toBeDefined();
      const payload = context.payload as { leaseContext: unknown; postApplicationCommit: string };
      expect(context.idempotencyKey).toBe(JSON.stringify([
        'candidate-finalization-lease-context', verified.integrationId, payload.leaseContext,
      ]));
      expect(payload.postApplicationCommit).toBe(git(verified.worktreePath, 'rev-parse', 'HEAD'));
      expect(records.at(-1)!.kind).toBe('candidate-integration-verified');
      expect(records.at(-1)!.idempotencyKey).toContain(context.idempotencyKey);
      keys.push(context.idempotencyKey);
      throw new Error('RECOVERY_INJECTED: before baseline');
    });
    const input = { controlRoot: root, integrationId: verified.integrationId, recoverBatchCheckpoints: recovery };
    await expect(module.finalizeCandidateIntegration(input)).rejects.toThrow('RECOVERY_INJECTED');
    await expect(module.finalizeCandidateIntegration(input)).rejects.toThrow('RECOVERY_INJECTED');
    expect(keys).toHaveLength(2);
    expect(new Set(keys).size).toBe(2);
    expect(git(root, 'rev-parse', 'main')).toBe(baseCommit);
    await journal.appendJournalRecord(root, {
      stream: 'normal', changeId: 'CHANGE-0014', kind: 'candidate-finalization-lease-context',
      idempotencyKey: 'malformed-later', payload: { integrationId: verified.integrationId, leaseContext: null },
    });
    await expect(module.finalizeCandidateIntegration(input)).rejects.toThrow('CANDIDATE_INTEGRATION_CONFLICT');
    expect(recovery).toHaveBeenCalledTimes(2);
  });

