      evidence.changes.push({
        changeId,generation: 1,activeGeneration: 1,requirementIds,tddBatches: [],
        phases: { design: { phase: 'design',order: order.sequence,fingerprints,recordedAt: '2026-09-27T00:00:00.000Z' } },
      });
    }
    writeFileSync(resolve(root,'.musubix/evidence/changes.json'),JSON.stringify(evidence));
    const checkpoint=(changeId: string,phase: 'red'|'implementation') => ({
      schemaVersion: 1 as const,changeId,generation: 1,phase,scopeId: requirementIds[0]!,
      repositoryId: `repository:${'f'.repeat(64)}`,workspaceHead: git(root,'rev-parse','HEAD'),
      requirementIds: [requirementIds[0]!],fingerprints,workspaceStateSha256: hash,tddEvidenceSha256: hash,
      semanticPhaseKey: `g1:${phase}:${requirementIds[0]}`,orderPhaseKey: `g1:${phase}:${requirementIds[0]}`,
      recordedAt: '2026-09-27T00:00:00.000Z',changeFencingToken: 1,projectionFencingToken: 1,
    });
    for(const id of ids) await appendBatchCheckpoint(root,checkpoint(id,'red'));
    const verified=await module.orchestrateCandidateIntegration({
      controlRoot: root,selectors: [firstId,secondId],verify: async () => verification,
    });
    const append=journal.appendJournalRecord;
    const spy=vi.spyOn(journal,'appendJournalRecord').mockImplementation(async (...args) => {
      if(args[1].kind==='candidate-integration-integrated') throw new Error('BEFORE_INTEGRATED');
      return append(...args);
    });
    const input={ controlRoot: root,integrationId: verified.integrationId,recoverBatchCheckpoints };
    await expect(module.finalizeCandidateIntegration(input)).rejects.toThrow('BEFORE_INTEGRATED');
    spy.mockRestore();
    for(const id of [...ids].reverse()) await appendBatchCheckpoint(root,checkpoint(id,'implementation'));
    await appendEvidenceOrder(root,{ kind: 'change',entityId: ids[1]!,phase: 'g1:implementation:REQ-FINALIZATION-001' });
    await expect(candidateState.withMultiChangeProjectionWrite(root,ids,async (leases) => {
      await recoverBatchCheckpoints(root,ids[0]!,leases);
      throw new Error('AFTER_FIRST_SELECTED');
    })).rejects.toThrow('AFTER_FIRST_SELECTED');
    const pending=(await loadChangeEvidence(root))!;
    expect(pending.changes[0]!.tddBatches?.[0]?.implementation).toBeDefined();
    await expect(module.finalizeCandidateIntegration(input)).resolves.toMatchObject({ state: 'integrated' });
    const recovered=(await loadChangeEvidence(root))!;
    expect(recovered.changes.every((change) => !!change.tddBatches?.[0]?.implementation)).toBe(true);
    expect((await journal.loadJournalRecords(root)).filter((record) => record.kind==='candidate-integration-integrated')).toHaveLength(1);
  });

  /** @id TEST-M5-FINALIZATION-TAIL-PUBLIC-001
   * @verifies REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-002 DES-M5-MULTI-CHANGE-008 DES-M5-MULTI-CHANGE-009
   */
  it('TEST-M5-FINALIZATION-TAIL-PUBLIC-001 resumes through the public selector API after loss of derived registry and integration projection',async () => {
    const { root,firstId,secondId }=await createFixture();
    const module=await import('../packages/analysis/src/candidate-integration.js');
    const verified=await module.orchestrateCandidateIntegration({
      controlRoot: root,selectors: [firstId,secondId],verify: async () => verification,
    });
    const append=journal.appendJournalRecord;
    const spy=vi.spyOn(journal,'appendJournalRecord').mockImplementation(async (...args) => {
      const record=await append(...args);
      if(args[1].kind==='candidate-integration-integrated') throw new Error('TAIL_PROJECTION_INTERRUPTED');
      return record;
    });
    await expect(module.finalizeCandidateIntegration({
      controlRoot: root,integrationId: verified.integrationId,recoverBatchCheckpoints,
    })).rejects.toThrow('TAIL_PROJECTION_INTERRUPTED');
    spy.mockRestore();
    const records=await journal.loadJournalRecords(root);
    rmSync(resolve(root,'.musubix/candidates/registry.json'));
    rmSync(integrationStateRoot(root,verified.integrationId),{ recursive: true });
    const verify=vi.fn(async () => verification);
    await expect(module.resumeCandidateIntegration({
      controlRoot: root,selectors: [secondId,firstId],recoverBatchCheckpoints,verify,
    })).resolves.toMatchObject({ state: 'integrated' });
    expect(verify).not.toHaveBeenCalled();
    expect(await journal.loadJournalRecords(root)).toEqual(records);
    expect(JSON.parse(readFileSync(resolve(root,'.musubix/candidates/registry.json'),'utf8')).candidates
      .every((candidate: { state: string }) => candidate.state==='integrated')).toBe(true);
  });

  /** @id TEST-M5-FINALIZATION-TAIL-RECOVERY-001
   * @verifies REQ-M5-MULTI-CHANGE-004 REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-002 DES-M5-MULTI-CHANGE-003 DES-M5-MULTI-CHANGE-008
   */
  it('TEST-M5-FINALIZATION-TAIL-RECOVERY-001 rebuilds journal-derived state across every finalization boundary without foreign credit or duplicate integrated records',async () => {
    for(const boundary of ['context','verified','recovery','materialized','before-integrated','after-integrated','control-reset','fenced'] as const) {
      const { root,firstId,secondId }=await createFixture();
      const module=await import('../packages/analysis/src/candidate-integration.js');
      const requirementIds=['REQ-FINALIZATION-001','REQ-FINALIZATION-002'];
      const hash='a'.repeat(64);
      const fingerprints={ impact: hash,requirements: hash,design: hash,implementation: hash,tests: hash,tdd: hash };
      const evidence: ChangeEvidence={ schemaVersion: 1,changes: [] };
      for(const changeId of ['CHANGE-0014','CHANGE-0015','CHANGE-0016']) {
        const order=await appendEvidenceOrder(root,{ kind: 'change',entityId: changeId,phase: 'g1:design' });
        evidence.changes.push({
          changeId,generation: 1,activeGeneration: 1,requirementIds,tddBatches: [],
          phases: { design: { phase: 'design',order: order.sequence,fingerprints,recordedAt: '2026-09-27T00:00:00.000Z' } },
        });
      }
      writeFileSync(resolve(root,'.musubix/evidence/changes.json'),JSON.stringify(evidence));
      const checkpoint=(changeId: string,phase: 'red'|'implementation') => ({
        schemaVersion: 1 as const,changeId,generation: 1,phase,scopeId: requirementIds[0]!,
        repositoryId: `repository:${'f'.repeat(64)}`,workspaceHead: git(root,'rev-parse','HEAD'),
        requirementIds: [requirementIds[0]!],fingerprints,workspaceStateSha256: hash,
        tddEvidenceSha256: hash,semanticPhaseKey: `g1:${phase}:${requirementIds[0]}`,
        orderPhaseKey: `g1:${phase}:${requirementIds[0]}`,recordedAt: '2026-09-27T00:00:00.000Z',
        changeFencingToken: 1,projectionFencingToken: 1,
      });
      await appendBatchCheckpoint(root,checkpoint('CHANGE-0014','red'));
      const foreign=await appendBatchCheckpoint(root,checkpoint('CHANGE-0016','red'));
      const verified=await module.orchestrateCandidateIntegration({
        controlRoot: root,selectors: [firstId,secondId],verify: async () => verification,
      });
      const markerPath=resolve(root,'.git/musubix5/finalizations',`${verified.integrationId.slice(12)}.json`);
      const projectionPath=resolve(integrationStateRoot(root,verified.integrationId),'integration.json');
      const registryPath=resolve(root,'.musubix/candidates/registry.json');
      const append=journal.appendJournalRecord;
      const appendSpy=vi.spyOn(journal,'appendJournalRecord').mockImplementation(async (...args) => {
        if(['before-integrated','control-reset'].includes(boundary)&&args[1].kind==='candidate-integration-integrated') {
          throw new Error('TAIL_BOUNDARY');
        }
        const record=await append(...args);
        if((boundary==='context'&&args[1].kind==='candidate-finalization-lease-context')
          ||(boundary==='verified'&&args[1].kind==='candidate-integration-verified')
          ||(boundary==='after-integrated'&&args[1].kind==='candidate-integration-integrated')) {
          throw new Error('TAIL_BOUNDARY');
        }
        return record;
      });
      const materialize=candidateState.materializeOperationalState;
      const copySpy=vi.spyOn(candidateState,'materializeOperationalState').mockImplementation(async (...args) => {
        const result=await materialize(...args);
        if(boundary==='materialized') throw new Error('TAIL_BOUNDARY');
        return result;
      });
      const authorize=journal.assertLeaseSetCurrent;
      let fencedBytes: string|undefined;
      const fenceSpy=vi.spyOn(journal,'assertLeaseSetCurrent').mockImplementation(async (...args) => {
        if(boundary==='fenced'&&existsSync(markerPath)&&!fencedBytes) {
          fencedBytes=readFileSync(registryPath,'utf8');
          const path=resolve(args[0].projectionLease.path,'owner.json');
          const owner=JSON.parse(readFileSync(path,'utf8'));
          writeFileSync(path,JSON.stringify({ ...owner,expiresAt: 0 }));
        }
        return authorize(...args);
      });
      await expect(module.finalizeCandidateIntegration({
        controlRoot: root,integrationId: verified.integrationId,
        recoverBatchCheckpoints: async (...args) => {
          const result=await recoverBatchCheckpoints(...args);
          if(boundary==='recovery') throw new Error('TAIL_BOUNDARY');
          return result;
        },
      })).rejects.toThrow(boundary==='fenced'? 'LEASE_FENCED':'TAIL_BOUNDARY');
      appendSpy.mockRestore();
      copySpy.mockRestore();
      fenceSpy.mockRestore();
      if(fencedBytes) {
        expect(readFileSync(registryPath,'utf8')).toBe(fencedBytes);
        expect(existsSync(markerPath)).toBe(true);
      }
      if(boundary==='control-reset') git(root,'reset','--hard',git(root,'rev-parse','main'));
      await appendBatchCheckpoint(root,checkpoint('CHANGE-0014','implementation'));
      if(['after-integrated','control-reset'].includes(boundary)) {
        rmSync(projectionPath);
        rmSync(registryPath);
      }
      const before=await journal.loadJournalRecords(root);
      const recoveries: string[]=[];
      const input={
        controlRoot: root,integrationId: verified.integrationId,
        recoverBatchCheckpoints: async (...args: Parameters<typeof recoverBatchCheckpoints>) => {
          recoveries.push(args[1]);
          return recoverBatchCheckpoints(...args);
        },
      };
      const result=await module.finalizeCandidateIntegration(input);
      expect(result.state,boundary).toBe('integrated');
      expect(existsSync(markerPath),boundary).toBe(false);
      expect(git(root,'rev-parse','main'),boundary).toBe(result.integrationCommit);
      const projected=(await loadChangeEvidence(root))!;
      expect(projected.changes[0]!.tddBatches?.[0]?.implementation,boundary).toBeDefined();
      expect(projected.changes[2],boundary).toEqual(evidence.changes[2]);
      expect(recoveries,boundary).not.toContain('CHANGE-0016');
      const after=await journal.loadJournalRecords(root);
      expect(after.slice(0,before.length),boundary).toEqual(before);
      expect(after.find((record) => record.idempotencyKey===foreign.idempotencyKey),boundary).toEqual(foreign);
      expect(after.filter((record) => record.kind==='candidate-integration-integrated'),boundary).toHaveLength(1);
      const registry=readFileSync(registryPath,'utf8');
      await expect(module.finalizeCandidateIntegration(input)).resolves.toMatchObject({ state: 'integrated' });
      expect(await journal.loadJournalRecords(root),boundary).toEqual(after);
      expect(readFileSync(registryPath,'utf8'),boundary).toBe(registry);
    }
  });

  /** @id TEST-M5-FINALIZATION-PRECAS-DRIFT-001
   * @verifies REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-002 DES-M5-MULTI-CHANGE-008
