  /** @id TEST-M5-FINALIZATION-DRIFT-001
   * @verifies REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-002 DES-M5-MULTI-CHANGE-008
   */
  it('TEST-M5-FINALIZATION-DRIFT-001 refuses operational drift after CAS without erasing the retained marker', async () => {
    const { root, firstId, secondId } = await createFixture();
    const module = await import('../packages/analysis/src/candidate-integration.js');
    const verified = await module.orchestrateCandidateIntegration({
      controlRoot: root, selectors: [firstId, secondId], verify: async () => verification,
    });
    const append = journal.appendJournalRecord;
    const spy = vi.spyOn(journal, 'appendJournalRecord').mockImplementation(async (...args) => {
      if (args[1].kind === 'candidate-integration-integrated') throw new Error('AFTER_CAS');
      return append(...args);
    });
    const input = { controlRoot: root, integrationId: verified.integrationId, recoverBatchCheckpoints };
    await expect(module.finalizeCandidateIntegration(input)).rejects.toThrow('AFTER_CAS');
    spy.mockRestore();
    const markerPath = resolve(root, '.git/musubix5/finalizations', `${verified.integrationId.slice(12)}.json`);
