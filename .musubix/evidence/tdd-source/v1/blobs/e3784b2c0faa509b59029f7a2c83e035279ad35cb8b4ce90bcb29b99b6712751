const roots: string[] = [];
const git = (root: string, ...args: string[]): string =>
  execFileSync('git', ['-C', root, ...args], { encoding: 'utf8' }).trim();

function commitFile(root: string, path: string, content: string, message: string): string {
  writeFileSync(resolve(root, path), content);
  git(root, 'add', path);
  git(root, 'commit', '-m', message);
  return git(root, 'rev-parse', 'HEAD');
}

async function createFixture(secondPath = 'second.txt') {
  const root = resolve('.test-work', `candidate-integration-${randomUUID()}`);
  roots.push(root);
  mkdirSync(root, { recursive: true });
  git(root, 'init', '--initial-branch=main');
  git(root, 'config', 'user.name', 'Integration Test');
  git(root, 'config', 'user.email', 'integration@example.invalid');
  const baseCommit = commitFile(root, 'base.txt', 'base\n', 'base');

  const common = resolve(root, '.git');
  const firstWorktree = resolve(common, 'musubix5/workspaces/candidates/first');
  const secondWorktree = resolve(common, 'musubix5/workspaces/candidates/second');
  mkdirSync(resolve(common, 'musubix5/workspaces/candidates'), { recursive: true });
  git(root, 'branch', 'candidate-first', baseCommit);
  git(root, 'branch', 'candidate-second', baseCommit);
  git(root, 'worktree', 'add', firstWorktree, 'candidate-first');
  git(root, 'worktree', 'add', secondWorktree, 'candidate-second');
  const firstCommit = commitFile(firstWorktree, 'first.txt', 'first\n', 'first');
  const secondCommit = commitFile(secondWorktree, secondPath, 'second\n', 'second');

  const repositoryId = `repository:${'f'.repeat(64)}`;
  const firstId = `candidate:${'a'.repeat(64)}`;
  const secondId = `candidate:${'b'.repeat(64)}`;
  await replaceCandidateRegistry(root, {
    schemaVersion: 1,
    repositoryId,
    candidates: [
      {
        schemaVersion: 1,
        candidateId: firstId,
        changeId: 'CHANGE-0014',
        generation: 1,
        repositoryId,
        creationEpoch: 1,
        baseCommit,
        candidateCommit: firstCommit,
        branch: 'candidate-first',
        worktreePath: 'musubix5/workspaces/candidates/first',
        state: 'ready',
        preparedOrder: 1,
        activeOrder: 2,
        dependencyIds: [],
      },
      {
        schemaVersion: 1,
        candidateId: secondId,
        changeId: 'CHANGE-0015',
        generation: 1,
        repositoryId,
        creationEpoch: 2,
        baseCommit,
        candidateCommit: secondCommit,
        branch: 'candidate-second',
        worktreePath: 'musubix5/workspaces/candidates/second',
        state: 'ready',
        preparedOrder: 3,
        activeOrder: 4,
        dependencyIds: [firstId],
      },
    ],
    integrations: [],
  });
  return { root, baseCommit, firstId, secondId };
}

const verification: ClosedIntegrationVerification = {
  requiredCommands: [{ name: 'test', status: 'passed' }],
  requiredChecks: [{ name: 'trace', status: 'passed', diagnostics: [] }],
  status: { exitCode: 0, ready: false },
};

afterEach(() => {
  vi.restoreAllMocks();
  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
});

describe('candidate integration orchestration', () => {
  /** @id TEST-M5-FINALIZATION-CONCURRENCY-SAME-001
   * @verifies REQ-M5-MULTI-CHANGE-006 REQ-M5-LIFECYCLE-006
   * @design DES-M5-MULTI-CHANGE-003 DES-M5-MULTI-CHANGE-008
   */
  it('TEST-M5-FINALIZATION-CONCURRENCY-SAME-001 serializes concurrent finalizers of the same selected set without duplicate transitions', async () => {
    const { root, firstId, secondId } = await createFixture();
    const module = await import('../packages/analysis/src/candidate-integration.js');
    const verified = await module.orchestrateCandidateIntegration({
      controlRoot: root, selectors: [firstId, secondId], verify: async () => verification,
    });
    let active = 0;
    let maximum = 0;
    const input = {
      controlRoot: root, integrationId: verified.integrationId,
      recoverBatchCheckpoints: async (...args: Parameters<typeof recoverBatchCheckpoints>) => {
        active += 1;
        maximum = Math.max(maximum, active);
        try {
          await journal.assertLeaseSetCurrent(args[2]);
          await new Promise((done) => setTimeout(done, 25));
          return await recoverBatchCheckpoints(...args);
        } finally { active -= 1; }
      },
    };
    const start = performance.now();
    const results = await Promise.all(Array.from({ length: 4 }, () => module.finalizeCandidateIntegration(input)));
    expect(performance.now() - start).toBeLessThan(10_000);
    expect(maximum).toBe(1);
    expect(results.every((result) => result.state === 'integrated')).toBe(true);
    expect(new Set(results.map((result) => result.integrationCommit)).size).toBe(1);
    expect((await journal.loadJournalRecords(root)).filter((record) => record.kind === 'candidate-integration-integrated')).toHaveLength(1);
  });

  /** @id TEST-M5-FINALIZATION-CONCURRENCY-DISJOINT-001
   * @verifies REQ-M5-MULTI-CHANGE-006 REQ-M5-LIFECYCLE-006
   * @design DES-M5-MULTI-CHANGE-003 DES-M5-MULTI-CHANGE-008
   */
  it('TEST-M5-FINALIZATION-CONCURRENCY-DISJOINT-001 permits disjoint CHANGE holders but serializes finalization and rejects the losing default CAS', async () => {
    const { root, firstId, secondId } = await createFixture();
    const registry = (await candidateState.readCandidateRegistry(root))!;
    for (const candidate of registry.candidates) candidate.dependencyIds = [];
    await replaceCandidateRegistry(root, registry);
    const module = await import('../packages/analysis/src/candidate-integration.js');
    const first = await module.orchestrateCandidateIntegration({
      controlRoot: root, selectors: [firstId], verify: async () => verification,
    });
    const second = await module.orchestrateCandidateIntegration({
      controlRoot: root, selectors: [secondId], verify: async () => verification,
    });
    let release!: () => void;
    let held!: () => void;
    const acquired = new Promise<void>((done) => { held = done; });
    const barrier = new Promise<void>((done) => { release = done; });
    const blocker = journal.withChangeProjectionLease(root, async () => { held(); await barrier; });
    await acquired;
    const start = performance.now();
    const finalizers = [first, second].map((attempt) => module.finalizeCandidateIntegration({
      controlRoot: root, integrationId: attempt.integrationId, recoverBatchCheckpoints,
    }));
    const settled = Promise.allSettled(finalizers);
    try {
      const deadline = performance.now() + 2_000;
      while (!(await journal.hasLiveChangeLease(root, 'CHANGE-0014') && await journal.hasLiveChangeLease(root, 'CHANGE-0015'))) {
        if (performance.now() >= deadline) throw new Error('Disjoint CHANGE leases were not held concurrently.');
        await new Promise((done) => setTimeout(done, 25));
      }
    } finally { release(); await blocker; }
    const results = await settled;
    expect(performance.now() - start).toBeLessThan(10_000);
    expect(results.filter((result) => result.status === 'fulfilled')).toHaveLength(1);
    const failed = results.filter((result) => result.status === 'rejected');
    expect(failed).toHaveLength(1);
    expect(failed[0]!.reason.message).toContain('CANDIDATE_BASE_STALE');
    expect((await journal.loadJournalRecords(root)).filter((record) => record.kind === 'candidate-integration-integrated')).toHaveLength(1);
    expect((await candidateState.readCandidateRegistry(root))!.candidates.map((candidate) => candidate.state).sort())
      .toEqual(['integrated', 'stale']);
  });

  /** @id TEST-M5-FINALIZATION-TAIL-PREFIX-001
   * @verifies REQ-M5-MULTI-CHANGE-006
   * @design DES-M5-MULTI-CHANGE-002 DES-M5-MULTI-CHANGE-008
   */
