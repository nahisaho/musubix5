      || typeof s.hrtimeAfterNs !== 'string' || !/^(0|[1-9][0-9]*)$/.test(s.hrtimeAfterNs)
      || typeof s.performanceMs !== 'number' || !Number.isFinite(s.performanceMs)) invalid('calibration');
    const before = BigInt(s.hrtimeBeforeNs), after = BigInt(s.hrtimeAfterNs);
