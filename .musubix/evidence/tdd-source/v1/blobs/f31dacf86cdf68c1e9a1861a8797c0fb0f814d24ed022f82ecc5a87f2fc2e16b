    const observed = object(request.context, 'blob-context', ['repositoryId', 'changeId', 'generation', 'commit', 'role']);
    for (const [key, expectedValue] of Object.entries(expected)) equal(observed[key], expectedValue, 'blob-context');
    if (context) equal(observed, context, 'blob-context');
