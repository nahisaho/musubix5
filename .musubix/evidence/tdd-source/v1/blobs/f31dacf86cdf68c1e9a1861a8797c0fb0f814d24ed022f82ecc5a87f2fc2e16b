  }
  const selected = brackets[selectedIndex]!, delta = selected.before + selected.after - BigInt(anchor.hrtimeNs) * 2n;
  if (selected.after - selected.before > 1_000_000n || delta > BigInt(Number.MAX_SAFE_INTEGER)) invalid('calibration');
