export async function publishTestRuntimeClosure(value: unknown) {
  const v = object(value, 'blob-schema', ['sourceRoot', 'controlRoot', 'provenance', 'context', 'platform']);
  const source = text(v.sourceRoot, 'blob-schema'), control = text(v.controlRoot, 'blob-schema');
