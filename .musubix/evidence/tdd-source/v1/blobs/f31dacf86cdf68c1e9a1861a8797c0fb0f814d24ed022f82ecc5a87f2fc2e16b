function invalid(reason: string, detail = ''): never {
  throw new Error(`TEST_RUNTIME_BOOTSTRAP_INVALID: ${reason}${detail ? `: ${detail}` : ''}`);
}

function object(value: unknown, reason: string, keys?: readonly string[]): Record<string, unknown> {
  if (!value || typeof value !== 'object' || Array.isArray(value)) invalid(reason, 'expected object');
  const descriptors = Object.getOwnPropertyDescriptors(value);
  if (![Object.prototype, null].includes(Object.getPrototypeOf(value))
    || Reflect.ownKeys(value).some((key) => typeof key !== 'string')
    || Object.values(descriptors).some((d) => !Object.hasOwn(d, 'value'))) invalid(reason, 'plain data required');
  if (keys && Object.keys(value).sort().join('\0') !== [...keys].sort().join('\0')) invalid(reason, 'closed fields');
  return value as Record<string, unknown>;
}

function text(value: unknown, reason: string): string {
  if (typeof value !== 'string' || !value.trim()) invalid(reason, 'expected string');
  return value;
}

function strings(value: unknown, reason: string): string[] {
  if (!Array.isArray(value) || !value.every((v): v is string => typeof v === 'string')) invalid(reason, 'string array');
  return value;
}

function equal(actual: unknown, expected: unknown, reason: string): void {
  if (hash(actual) !== hash(expected)) invalid(reason, 'binding mismatch');
}

/** @id CODE-M5-TEST-RUNTIME-PROFILE-001
 * @implements REQ-M5-COMPAT-013 REQ-M5-LIFECYCLE-006
 * @design DES-M5-015
 */
export function expectedTestRuntimeProfileSha256(kind: string, schemaVersion: number): string {
  const expected = profileDigests[`${kind}:${schemaVersion}`];
  if (!expected || hash(testRuntimeProfile) !== expected) {
    invalid('profile-digest');
  }
  return expected;
}

export function validateTestRuntimeProfile(value: unknown): TestRuntimeProfile {
  const profile = object(value, 'profile-digest', ['calibration', 'commandNames', 'inputs', 'kind', 'reporterMode', 'schemaVersion']);
  object(profile.calibration, 'profile-digest', ['maxWidthMs', 'samples']);
  strings(profile.commandNames, 'profile-digest');
  strings(profile.inputs, 'profile-digest');
  if (hash(value) !== expectedTestRuntimeProfileSha256('stable-test-wall-clock-v1', 1)) invalid('profile-digest');
  equal(value, testRuntimeProfile, 'profile-digest');
  return testRuntimeProfile;
}

type Invocation = { command: string; args: string[] };
type Locations = { repo: string; run: string; 'command-run': string };

function invocation(value: unknown): Invocation {
  const v = object(value, 'augmentation-binding', ['command', 'args']);
  return { command: text(v.command, 'augmentation-binding'), args: strings(v.args, 'augmentation-binding') };
}

function observedVitestArgs(value: Invocation): string[] {
  return value.command === 'npm'
    ? ['run', 'tests/cli-help-contract.test.ts', 'tests/cli-json-error-contract.test.ts',
      'tests/compatibility-oracle.test.ts', ...value.args.slice(value.args.indexOf('--') + 1)]
    : value.args.slice(1);
}

function locations(value: unknown): Locations {
  const v = object(value, 'augmentation-binding', ['repo', 'run', 'command-run']);
  const original = { repo: text(v.repo, 'augmentation-binding'), run: text(v.run, 'augmentation-binding'),
    'command-run': text(v['command-run'], 'augmentation-binding') };
  for (const p of Object.values(original)) if (!isAbsolute(p)) invalid('unsafe-path');
  return { repo: resolve(original.repo), run: resolve(original.run), 'command-run': resolve(original['command-run']) };
}

function composition(logical: Invocation, where: Locations) {
  let args = [...logical.args];
  const npm = logical.command === 'npm';
  if (npm && (args[0] !== 'run' || args[1] !== 'test:compat')) invalid('augmentation-binding', 'npm launcher');
  if (!npm && !(logical.command === 'npx' && args[0] === 'vitest')
    && !([process.execPath, join(where.repo, '.musubix-runtime/bin/node'),
      join(where.repo, '.musubix-runtime/bin/node.exe')].includes(logical.command) && typeof args[0] === 'string'
      && (args[0] === 'node_modules/vitest/vitest.mjs' || args[0] === join(where.repo, 'node_modules/vitest/vitest.mjs')))) {
    invalid('augmentation-binding', 'launcher');
  }
  const separators = args.flatMap((arg, i) => arg === '--' ? [i] : []);
  if (separators.length > 1) invalid('augmentation-binding', 'ambiguous separators');
  const npmForwardingBoundary = npm && !separators.length;
  if (npmForwardingBoundary) args.push('--');
  const suffix = !npm && separators.length ? args.splice(separators[0]!) : [];
  const runtimeReporter = `--reporter=${join(where.repo, reporterPath)}`;
  const normalized: string[] = [];
  let reporter = false;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i]!;
    const value = arg === '--reporter' ? args[i + 1] : arg.startsWith('--reporter=') ? arg.slice(11) : undefined;
    if (value !== undefined) {
      if (value.includes('coordinator-reporter.mjs')) {
        if (value !== join(where.repo, reporterPath)) invalid('augmentation-binding', 'foreign runtime reporter');
        if (arg === '--reporter') i++;
        continue;
      }
      reporter = true;
    } else if (arg === '--reporter') invalid('augmentation-binding', 'missing reporter value');
    normalized.push(arg);
  }
  if (!reporter) normalized.push('--reporter=default');
  normalized.push(runtimeReporter, ...suffix);
  return { args: normalized, defaultReporter: !reporter, npmForwardingBoundary };
}

/** @id CODE-M5-TEST-RUNTIME-AUGMENTATION-001
 * @implements REQ-M5-COMPAT-013 REQ-M5-LIFECYCLE-006
 * @design DES-M5-015
 */
export function augmentTestRuntimeInvocation(value: unknown) {
  const v = object(value, 'augmentation-binding');
  if (Object.keys(v).some((k) => !['logicalInvocation', 'profileSha256', 'anchor', 'runId', 'commandRunId', 'locations'].includes(k))) {
    invalid('augmentation-binding', 'unknown argument');
  }
  equal(v.profileSha256, testRuntimeProfileSha256, 'profile-digest');
  const logical = invocation(v.logicalInvocation), where = locations(v.locations);
  const runId = text(v.runId, 'augmentation-binding'), commandRunId = text(v.commandRunId, 'augmentation-binding');
  const composed = composition(logical, where);
  const augmentation = {
    schemaVersion: 1, kind: 'test-runtime-augmentation-v1', profileSha256: testRuntimeProfileSha256,
    reporterPath: `repo:${reporterPath}`, defaultReporter: composed.defaultReporter,
    npmForwardingBoundary: composed.npmForwardingBoundary, preloadPath: `repo:${preloadPath}`,
    setupPath: 'repo:scripts/test-runtime/vitest-setup.mjs', requestPath: 'run:request.json',
    dispatchPath: 'command-run:dispatch.json', ackPath: 'run:ack.json',
    workerPacketPath: 'run:worker-acks/{workerId}.json', clockMarker: 'anchor-ref',
  };
  return {
    logicalInvocation: logical, logicalCommandSha256: rawHash([logical.command, logical.args]),
    augmentation, augmentationSha256: hash(augmentation),
    resolvedInvocation: { command: logical.command, args: composed.args },
    resolvedRuntimeEnvironment: {
      NODE_OPTIONS: `--import=${pathToFileURL(join(where.repo, preloadPath)).href}`,
      MUSUBIX5_TEST_RUNTIME_REQUEST: join(where.run, 'request.json'),
      MUSUBIX5_TEST_RUNTIME_DISPATCH: join(where['command-run'], 'dispatch.json'),
      clockMarker: { runId, commandRunId, anchor: v.anchor ?? null },
    },
    locations: where,
  };
}

export function validateTestRuntimeExecutionBinding(value: unknown): void {
  const v = object(value, 'augmentation-binding', ['logicalInvocation', 'logicalCommandSha256', 'augmentation',
    'augmentationSha256', 'resolvedInvocation', 'resolvedRuntimeEnvironment', 'locations']);
  const environment = object(v.resolvedRuntimeEnvironment, 'augmentation-binding',
    ['NODE_OPTIONS', 'MUSUBIX5_TEST_RUNTIME_REQUEST', 'MUSUBIX5_TEST_RUNTIME_DISPATCH', 'clockMarker']);
  const marker = object(environment.clockMarker, 'augmentation-binding', ['runId', 'commandRunId', 'anchor']);
  const expected = augmentTestRuntimeInvocation({
    logicalInvocation: v.logicalInvocation, profileSha256: testRuntimeProfileSha256,
    runId: marker.runId, commandRunId: marker.commandRunId, locations: v.locations,
    ...(marker.anchor === null ? {} : { anchor: marker.anchor }),
  });
  equal(v, expected, 'augmentation-binding');
}

export function validateTestRuntimeGroups(description: unknown, bindings: unknown): void {
  const described = object(description, 'augmentation-binding', ['schemaVersion', 'groups']);
  if (described.schemaVersion !== 1 || !Array.isArray(described.groups) || !Array.isArray(bindings)
    || described.groups.length !== bindings.length || !bindings.length) invalid('augmentation-binding', 'group count');
  const ids = new Set<string>();
  for (const [i, value] of bindings.entries()) {
    const b = object(value, 'augmentation-binding', ['ordinal', 'runId', 'group', 'executionBinding']);
    const group = object(b.group, 'augmentation-binding', ['ordinal', 'testIds', 'testFiles', 'command', 'args']);
    if (b.ordinal !== i || group.ordinal !== i) invalid('augmentation-binding', 'group order');
    equal(b.group, described.groups[i], 'augmentation-binding');
    const id = text(b.runId, 'augmentation-binding');
    if (ids.has(id)) invalid('augmentation-binding', 'duplicate run');
    ids.add(id);
    validateTestRuntimeExecutionBinding(b.executionBinding);
    const binding = object(b.executionBinding, 'augmentation-binding');
    equal(binding.logicalInvocation, { command: group.command, args: group.args }, 'augmentation-binding');
    equal(object(object(binding.resolvedRuntimeEnvironment, 'augmentation-binding').clockMarker,
      'augmentation-binding').runId, id, 'augmentation-binding');
  }
}

const blobDirectory = (root: string): string => join(root, '.musubix/evidence/test-runtime/v1/blobs');
const blobFields: Record<string, string[]> = {
  'test-runtime-file-v1': ['path', 'mode', 'size', 'rawSha256', 'contentBase64'],
  'test-runtime-inputs-v1': ['entries'],
  'test-runtime-request-v1': ['runId', 'commandRunId', 'commandName', 'origin', 'context',
    'configuredInvocation', 'effectiveInvocation', 'executionBinding', 'selectedTestIds', 'selectedFiles',
    'profileSha256', 'inputsSha256', 'dispatchSha256'],
  'test-runtime-anchor-v1': ['runId', 'wallEpochMs', 'monoEpochMs', 'hrtimeNs'],
  'test-runtime-worker-v1': ['runId', 'requestSha256', 'worker', 'provider', 'markerMetadata'],
  'test-runtime-dispatch-v1': ['commandRunId', 'commandSha256', 'profileSha256', 'inputsSha256', 'invocations'],
  'test-runtime-ack-v1': ['runId', 'requestSha256', 'profileSha256', 'inputsSha256', 'nodeVersion', 'platform',
    'anchor', 'anchorSha256', 'workers', 'files', 'workerSha256s', 'reporterRegistration',
    'reportedFailed', 'bootstrapErrors', 'complete'],
  'test-runtime-result-v1': ['runId', 'requestSha256', 'effectiveInvocation', 'executionBinding',
    'status', 'exitCode', 'durationMs', 'nativeReportBase64'],
};

function address(value: unknown): string {
  if (typeof value !== 'string' || !/^[a-f0-9]{64}$/.test(value)) invalid('blob-schema', 'address');
  return value;
}

function array(value: unknown, reason = 'blob-schema'): unknown[] {
  if (!Array.isArray(value)) invalid(reason, 'array required');
  return value;
}

function base64(value: unknown): Buffer {
  if (typeof value !== 'string') invalid('blob-schema', 'base64 required');
  const bytes = Buffer.from(value, 'base64');
  if (bytes.toString('base64') !== value) invalid('blob-schema', 'canonical base64 required');
  return bytes;
}

async function regular(path: string, ancestors?: Map<string, Promise<Stats>>): Promise<Buffer> {
  for (let parent = dirname(path); parent !== dirname(parent); parent = dirname(parent)) {
    let pending = ancestors?.get(parent);
    if (!pending) {
      pending = lstat(parent);
      ancestors?.set(parent, pending);
    }
    const stat = await pending;
    if (stat.isSymbolicLink() || !stat.isDirectory()) invalid('unsafe-path', parent);
  }
  const before = await lstat(path);
  if (!before.isFile() || before.isSymbolicLink()) invalid('unsafe-path', path);
  const bytes = await readFile(path);
  const after = await lstat(path);
  if (before.dev !== after.dev || before.ino !== after.ino || before.size !== after.size
    || before.mtimeMs !== after.mtimeMs) invalid('blob-io', 'file changed during read');
  return bytes;
}

function errno(cause: unknown, code: string): boolean {
  return cause instanceof Error && 'code' in cause && cause.code === code;
}

async function durableBlob(root: string, bytes: Buffer, platform: string): Promise<string> {
  const directory = blobDirectory(root), digest = sha256(bytes), target = join(directory, digest);
  await mkdir(directory, { recursive: true, mode: 0o700 });
  const temporary = join(directory, `.${digest}.${randomUUID()}.tmp`);
  try {
    const file = await open(temporary, 'wx', 0o600);
    try { await file.writeFile(bytes); await file.sync(); } finally { await file.close(); }
    try { await link(temporary, target); } catch (cause) {
      if (!errno(cause, 'EEXIST')) throw cause;
    }
    if (!(await regular(target)).equals(bytes)) invalid('blob-io', `collision or post-write mismatch: ${digest}`);
    if (platform !== 'win32') {
      const directoryHandle = await open(directory, 'r');
      try { await directoryHandle.sync(); } finally { await directoryHandle.close(); }
    }
    await unlink(temporary);
    if (platform !== 'win32') {
      const directoryHandle = await open(directory, 'r');
      try { await directoryHandle.sync(); } finally { await directoryHandle.close(); }
    }
    if (!(await regular(target)).equals(bytes)) invalid('blob-io', `final rehash: ${digest}`);
  } catch (cause) {
    invalid('blob-io', cause instanceof Error ? cause.message : String(cause));
  }
  return digest;
}

function blobSchema(value: unknown): Record<string, unknown> {
  const v = object(value, 'blob-schema');
  if (v.kind === 'stable-test-wall-clock-v1') {
    validateTestRuntimeProfile(v);
    return v;
  }
  const fields = typeof v.kind === 'string' ? blobFields[v.kind] : undefined;
  if (!fields || v.schemaVersion !== 1) invalid('blob-schema', 'kind/version');
  return object(v, 'blob-schema', ['schemaVersion', 'kind', ...fields]);
}

function references(v: Record<string, unknown>): string[] {
  const refs: unknown[] = [];
  if (v.kind === 'test-runtime-inputs-v1') {
    for (const entry of array(v.entries)) refs.push(object(entry, 'blob-schema').blobSha256);
  }
  if (['test-runtime-request-v1', 'test-runtime-dispatch-v1', 'test-runtime-ack-v1'].includes(String(v.kind))) {
    refs.push(v.profileSha256, v.inputsSha256);
  }
  if (v.kind === 'test-runtime-request-v1') refs.push(v.dispatchSha256);
  if (['test-runtime-worker-v1', 'test-runtime-result-v1', 'test-runtime-ack-v1'].includes(String(v.kind))) refs.push(v.requestSha256);
  if (v.kind === 'test-runtime-ack-v1') refs.push(v.anchorSha256, ...array(v.workerSha256s));
  return refs.map(address);
}

function provenanceSchema(value: unknown) {
  const fields = ['kind', 'profileSha256', 'inputsSha256', 'dispatchSha256', 'runs', 'publication'];
  const initial = object(value, 'blob-schema');
  const v = object(initial, 'blob-schema', Object.hasOwn(initial, 'activation') ? [...fields, 'activation'] : fields);
  if (v.kind !== testRuntimeProfile.kind || v.profileSha256 !== testRuntimeProfileSha256) invalid('profile-digest');
  const runs = array(v.runs).map((run) => object(run, 'blob-schema',
    ['ordinal', 'runId', 'requestSha256', 'anchorSha256', 'acknowledgmentSha256', 'resultSha256']));
  if (!runs.length || new Set(runs.map((r) => r.runId)).size !== runs.length
    || runs.some((r, i) => r.ordinal !== i)) invalid('blob-schema', 'run inventory');
  const publication = object(v.publication, 'blob-schema', ['durability', 'closureSha256']);
  if (!['posix-file-directory-fsync', 'win32-file-flush-no-replace-rehash'].includes(String(publication.durability))) {
    invalid('blob-schema', 'durability');
  }
  address(publication.closureSha256);
  return { v, runs, publication };
}

async function runtimeClosure(root: string, value: unknown, context: unknown) {
  const { v, runs, publication } = provenanceSchema(value);
  const bytes = new Map<string, Buffer>(), objects = new Map<string, Record<string, unknown>>();
  const ancestors = new Map<string, Promise<Stats>>();
  const pending = [v.profileSha256, v.inputsSha256, v.dispatchSha256,
    ...runs.flatMap((r) => [r.requestSha256, r.anchorSha256, r.acknowledgmentSha256, r.resultSha256])].map(address);
  while (pending.length) {
    const round = [...new Set(pending.splice(0))].filter((digest) => !objects.has(digest));
    const reads = await Promise.allSettled(round.map((digest) =>
      regular(join(blobDirectory(root), digest), ancestors)));
    for (const [index, digest] of round.entries()) {
      const result = reads[index]!;
      if (result.status === 'rejected') {
        if (errno(result.reason, 'ENOENT')) invalid('blob-missing', digest);
        throw result.reason;
      }
      const content = result.value;
      let parsed: unknown;
      try {
        const decoded = new TextDecoder('utf-8', { fatal: true }).decode(content);
        parsed = JSON.parse(decoded);
      } catch (cause) { invalid('blob-schema', cause instanceof Error ? cause.message : String(cause)); }
      const blob = blobSchema(parsed);
      if (!content.equals(canonicalBytes(blob))) invalid('blob-schema', 'noncanonical JSON');
      if (sha256(content) !== digest) invalid('blob-hash', digest);
      bytes.set(digest, content); objects.set(digest, blob);
      pending.push(...references(blob));
    }
  }
  const get = (digest: unknown, kind: string) => {
    const blob = objects.get(address(digest));
    if (!blob || blob.kind !== kind) invalid('blob-schema', `expected ${kind}`);
    return blob;
  };
  get(v.profileSha256, 'stable-test-wall-clock-v1');
  const inputs = get(v.inputsSha256, 'test-runtime-inputs-v1');
  const entries = array(inputs.entries).map((entry) => object(entry, 'blob-schema',
    ['path', 'mode', 'size', 'rawSha256', 'blobSha256']));
  equal(entries.map((e) => e.path), testRuntimeProfile.inputs, 'blob-schema');
  for (const entry of entries) {
    const file = get(entry.blobSha256, 'test-runtime-file-v1'), content = base64(file.contentBase64);
    equal({ path: file.path, mode: file.mode, size: file.size, rawSha256: file.rawSha256 },
      { path: entry.path, mode: entry.mode, size: entry.size, rawSha256: entry.rawSha256 }, 'blob-schema');
    if (![100644, 100755].includes(Number(file.mode)) || content.length !== file.size
      || sha256(content) !== file.rawSha256) invalid('blob-hash', 'input snapshot');
  }
  const bootstrapSha256 = entries.find((entry) => entry.path === preloadPath)!.rawSha256;
  const dispatch = get(v.dispatchSha256, 'test-runtime-dispatch-v1');
  equal(dispatch.profileSha256, v.profileSha256, 'blob-context');
  equal(dispatch.inputsSha256, v.inputsSha256, 'blob-context');
  const dispatched = array(dispatch.invocations);
  if (dispatched.length !== runs.length) invalid('acknowledgment-binding', 'dispatch inventory');
  for (const [ordinal, run] of runs.entries()) {
    const request = get(run.requestSha256, 'test-runtime-request-v1');
    const anchor = get(run.anchorSha256, 'test-runtime-anchor-v1');
    const ack = get(run.acknowledgmentSha256, 'test-runtime-ack-v1');
    const result = get(run.resultSha256, 'test-runtime-result-v1');
    object(request.context, 'blob-context', ['repositoryId', 'changeId', 'generation', 'commit', 'role']);
    equal(request.context, context, 'blob-context');
    if (!['configured', 'standalone'].includes(String(request.origin))) invalid('blob-schema', 'origin');
    for (const blob of [request, ack, result]) equal(blob.runId, run.runId, 'acknowledgment-stale');
    for (const blob of [request, ack]) {
      equal(blob.profileSha256, v.profileSha256, 'blob-context');
      equal(blob.inputsSha256, v.inputsSha256, 'blob-context');
    }
    equal(request.commandRunId, dispatch.commandRunId, 'blob-context');
    equal(request.dispatchSha256, v.dispatchSha256, 'blob-context');
    for (const blob of [ack, result]) equal(blob.requestSha256, run.requestSha256, 'acknowledgment-stale');
    validateTestRuntimeExecutionBinding(request.executionBinding);
    equal(result.executionBinding, request.executionBinding, 'augmentation-binding');
    const binding = object(request.executionBinding, 'augmentation-binding');
