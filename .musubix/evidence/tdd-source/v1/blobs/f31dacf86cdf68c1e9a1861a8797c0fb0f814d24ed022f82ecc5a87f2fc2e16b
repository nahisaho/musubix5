    if (token === preload || token === '--enable-source-maps') continue;
    if (!/^--max-old-space-size=[1-9][0-9]*$/.test(token)
      || !Number.isSafeInteger(Number(token.split('=')[1]))
      || memory !== undefined && memory !== token) invalid('node-options');
    memory = token;
  }
  if (tokens.includes(preload) !== Boolean(env.MUSUBIX5_TEST_RUNTIME_CLOCK)) invalid('worker-scope');
  delete env.MUSUBIX5_TEST_RUNTIME_CLOCK;
  delete env.MUSUBIX5_TEST_RUNTIME_REQUEST;
  delete env.MUSUBIX5_TEST_RUNTIME_DISPATCH;
  const retained = tokens.filter((token) => token !== preload);
  if (retained.length) env.NODE_OPTIONS = retained.join(' ');
  else delete env.NODE_OPTIONS;
  return env;
}

async function runtimeAnchor(root: string, runId: string, environment = process.env): Promise<Anchor> {
  cleanTestRuntimeBuildEnvironment(root, environment);
  if (environment.MUSUBIX5_TEST_RUNTIME_CLOCK) {
    const provider = object(JSON.parse(environment.MUSUBIX5_TEST_RUNTIME_CLOCK), 'worker-scope',
      ['schemaVersion', 'kind', 'executionRunId', 'profileSha256', 'bootstrapSha256', 'inputsSha256', 'anchorId', 'anchor']);
    const anchor = validateAnchorData(provider.anchor);
    if (provider.schemaVersion !== 1 || provider.kind !== 'test-runtime-provider-v1'
      || provider.profileSha256 !== testRuntimeProfileSha256 || provider.anchorId !== hash(anchor)) invalid('worker-scope');
    text(provider.executionRunId, 'worker-scope');
    address(provider.bootstrapSha256); address(provider.inputsSha256);
    return anchor;
  }
  return { schemaVersion: 1, kind: 'test-runtime-anchor-v1', runId,
    wallEpochMs: Date.now(), monoEpochMs: performance.now(), hrtimeNs: process.hrtime.bigint().toString() };
}

async function allocateRuntimeRun(root: string, runId: string): Promise<string> {
  const run = join(root, '.musubix/cache/test-runtime', runId);
  await mkdir(dirname(run), { recursive: true, mode: 0o700 });
  await mkdir(run, { mode: 0o700 });
  await mkdir(join(run, 'worker-acks'), { mode: 0o700 });
  return run;
}

export async function testRuntimeExecutionContext(
  root: string, role: TestRuntimeContext['role'], runner: Runner,
  change: { changeId: string; generation: number | null } | null = null,
): Promise<TestRuntimeContext> {
  const revision = await runner('git', ['rev-parse', 'HEAD'], { cwd: root, timeoutMs: 10_000 });
  const origin = await runner('git', ['config', '--get', 'remote.origin.url'], { cwd: root, timeoutMs: 10_000 });
  if (revision.status !== 'completed' || revision.exitCode !== 0
    || origin.status !== 'completed' || ![0, 1].includes(origin.exitCode ?? -1)) invalid('blob-context', 'repository unavailable');
  return {
    repositoryId: canonicalRepositoryIdentity(origin.exitCode === 0 ? origin.stdout.trim() : undefined, root),
    changeId: change?.changeId ?? null, generation: change?.generation ?? null,
    commit: revision.stdout.trim(), role,
  };
}

function nativeReportPath(args: string[], cwd: string): string | null {
  const values = args.flatMap((arg, index) => arg === '--outputFile' ? [args[index + 1]]
    : arg.startsWith('--outputFile=') ? [arg.slice('--outputFile='.length)] : []);
  if (values.length > 1 || values.some((value) => !value)) invalid('augmentation-binding', 'native report path');
  return values.length ? resolve(cwd, text(values[0], 'augmentation-binding')) : null;
}

/** @id CODE-M5-TEST-RUNTIME-COMMAND-001
 * @implements REQ-M5-COMPAT-013 REQ-M5-LIFECYCLE-006
 * @design DES-M5-015
 */
export async function runTestRuntimeCommand(
  root: string, command: CommandConfig, args: string[],
  options: Parameters<Runner>[2], runner: Runner, context: TestRuntimeContext,
  controlRoot = root,
): Promise<ProcessResult & { testRuntime: TestRuntimeProvenance }> {
  root = resolve(root);
  const commandRunId = randomUUID(), transport = await allocateRuntimeRun(root, commandRunId);
  const snapshot = await snapshotRuntime(root, transport);
  const environment = options.env ?? process.env;
  const anchor = await runtimeAnchor(root, commandRunId, environment);
  const tokens = (cleanTestRuntimeBuildEnvironment(root, environment).NODE_OPTIONS ?? '').split(/[ \t]+/).filter(Boolean);
  const commandHash = rawHash([command.command, args]);
  let groups: Array<{ ordinal: number; testIds: string[]; testFiles: string[]; command: string; args: string[] }>;
  if (command.name === 'codegraph-tests') {
    const described = await runner(command.command, [...args, '--describe-groups'], options);
    if (described.status !== 'completed' || described.exitCode !== 0) invalid('augmentation-binding', described.stderr);
    const description = object(JSON.parse(described.stdout), 'augmentation-binding', ['schemaVersion', 'groups']);
    if (description.schemaVersion !== 1) invalid('augmentation-binding');
    groups = array(description.groups, 'augmentation-binding').map((entry, ordinal) => {
      const g = object(entry, 'augmentation-binding', ['ordinal', 'testIds', 'testFiles', 'command', 'args']);
      if (g.ordinal !== ordinal || ![process.execPath, join(root, '.musubix-runtime/bin/node'),
        join(root, '.musubix-runtime/bin/node.exe')].includes(String(g.command))) invalid('augmentation-binding');
      const groupCommand = text(g.command, 'augmentation-binding');
      return { ordinal, command: groupCommand, args: strings(g.args, 'augmentation-binding'),
        testIds: strings(g.testIds, 'augmentation-binding'), testFiles: strings(g.testFiles, 'augmentation-binding') };
    });
  } else {
    const inventory = (await files(root)).filter((path) => /^tests\/.*\.test\.tsx?$/.test(path));
    const selectors = args.filter((arg) => !arg.startsWith('-') && /^tests\//.test(arg));
    const compatibility = ['tests/cli-help-contract.test.ts', 'tests/cli-json-error-contract.test.ts', 'tests/compatibility-oracle.test.ts'];
    const selected = command.name === 'compatibility' ? compatibility
      : selectors.length ? inventory.filter((path) => selectors.some((selector) => path.includes(selector))) : inventory;
    groups = [{ ordinal: 0, command: command.command, args,
      testFiles: selected.sort(), testIds: [...new Set(args.flatMap((arg) => arg.match(/TEST-[A-Z0-9-]+/g) ?? []))] }];
  }
  if (!groups.length || groups.some((group) => !group.testFiles.length)) invalid('augmentation-binding', 'empty dispatch');
  const issued = [];
  for (const group of groups) {
    await authorizeTestRuntimeNode(root, ['npx', 'npm'].includes(group.command) ? process.execPath : group.command);
    const runId = command.name === 'codegraph-tests' ? randomUUID() : commandRunId;
    const run = runId === commandRunId ? transport : await allocateRuntimeRun(root, runId);
    const executionBinding = augmentTestRuntimeInvocation({
      logicalInvocation: { command: group.command, args: group.args }, profileSha256: snapshot.profileSha256,
      runId, commandRunId, anchor, locations: { repo: root, run, 'command-run': transport },
    });
    const provider: TestRuntimeProvider = {
      schemaVersion: 1, kind: 'test-runtime-provider-v1', executionRunId: runId,
      profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256,
      bootstrapSha256: snapshot.entries.find((entry) => entry.path === preloadPath)!.rawSha256,
      anchorId: hash(anchor), anchor,
    };
    issued.push({ group, runId, run, executionBinding, provider });
  }
  if (command.name === 'codegraph-tests') validateTestRuntimeGroups({ schemaVersion: 1, groups },
    issued.map(({ group, runId, executionBinding }) => ({ ordinal: group.ordinal, runId, group, executionBinding })));
  const dispatch = {
    schemaVersion: 1, kind: 'test-runtime-dispatch-v1', commandRunId, commandSha256: commandHash,
    profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256,
    invocations: issued.map(({ group, runId, executionBinding }) => ({
      ordinal: group.ordinal, runId,
      argv: [executionBinding.resolvedInvocation.command, ...executionBinding.resolvedInvocation.args],
      selectedTestIds: group.testIds, selectedFiles: [...group.testFiles].sort(), executionBinding,
    })),
  };
  const dispatchSha256 = await durableBlob(transport, canonicalBytes(dispatch), process.platform);
  await transportJson(join(transport, 'dispatch.json'), dispatch, true);
  await durableBlob(transport, canonicalBytes(anchor), process.platform);
  const prepared = [];
  for (const entry of issued) {
    const { group, runId, run, executionBinding, provider } = entry;
    const request = {
      schemaVersion: 1, kind: 'test-runtime-request-v1', runId, commandRunId,
      commandName: command.name, origin: 'configured', context,
      configuredInvocation: { command: command.command, args: command.args },
      effectiveInvocation: executionBinding.resolvedInvocation, executionBinding,
      selectedTestIds: group.testIds, selectedFiles: [...group.testFiles].sort(),
      profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256, dispatchSha256,
    };
    const requestSha256 = await durableBlob(transport, canonicalBytes(request), process.platform);
    await transportJson(join(run, 'request.json'), request, true);
    const env = { ...environment,
      NODE_OPTIONS: [...tokens, executionBinding.resolvedRuntimeEnvironment.NODE_OPTIONS].join(' '),
      MUSUBIX5_TEST_RUNTIME_CLOCK: JSON.stringify(provider),
      MUSUBIX5_TEST_RUNTIME_REQUEST: join(run, 'request.json'),
      MUSUBIX5_TEST_RUNTIME_DISPATCH: join(transport, 'dispatch.json') };
    prepared.push({ ...entry, request, requestSha256, env, resultPath: join(run, 'process-result.json') });
  }
  let execution: ProcessResult;
  if (command.name === 'codegraph-tests') {
    const groupPath = join(transport, 'groups.json');
    await transportJson(groupPath, { schemaVersion: 1, groups: prepared.map((entry) => ({
      ordinal: entry.group.ordinal, ...entry.executionBinding.resolvedInvocation,
      env: entry.env, resultPath: entry.resultPath,
    })) }, true);
    execution = await runner(command.command, [...args, '--runtime-dispatch', groupPath], options);
  } else {
    const entry = prepared[0]!;
    validateTestRuntimeExecutionBinding(entry.executionBinding);
    const effective = entry.executionBinding.resolvedInvocation;
    const node = ['npx', 'npm'].includes(effective.command) ? process.execPath : effective.command;
    await authorizeTestRuntimeNode(root, node);
    execution = await runner(node, [join(root, 'node_modules/vitest/vitest.mjs'), ...observedVitestArgs(effective)],
      { ...options, env: entry.env });
  }
  if (execution.status !== 'completed') {
    invalid('acknowledgment-binding', `incomplete command (${execution.status}); exit code ${execution.exitCode}; duration ${execution.durationMs} ms`);
  }
  const runs: TestRuntimeProvenance['runs'] = [];
  for (const entry of prepared) {
    let native = execution;
    let report: Buffer | null = null;
    if (command.name === 'codegraph-tests') {
      const result = object(JSON.parse((await regular(entry.resultPath)).toString('utf8')), 'acknowledgment-binding',
        ['status', 'exitCode', 'durationMs', 'nativeReportBase64']);
      const status = result.status;
      if (status !== 'completed' && status !== 'missing' && status !== 'timeout' && status !== 'error'
        || !Number.isSafeInteger(result.durationMs)) invalid('acknowledgment-binding');
      native = { ...execution, status,
        exitCode: result.exitCode === null ? null : Number(result.exitCode), durationMs: Number(result.durationMs) };
      report = result.nativeReportBase64 === null ? null : base64(result.nativeReportBase64);
    } else {
      const path = nativeReportPath(entry.executionBinding.resolvedInvocation.args, options.cwd);
      if (path) {
        try { report = await regular(path); } catch (cause) {
          if (!errno(cause, 'ENOENT')) throw cause;
        }
      }
    }
    if (native.status !== 'completed') {
      invalid('acknowledgment-binding', `incomplete command (${native.status}); exit code ${native.exitCode}; duration ${native.durationMs} ms`);
    }
    let ackBytes: Buffer;
    try {
      ackBytes = await regular(join(entry.run, 'ack.json'));
    } catch (cause) {
      if (errno(cause, 'ENOENT')) invalid('acknowledgment-binding', 'missing acknowledgment');
      throw cause;
    }
    const ack = blobSchema(JSON.parse(ackBytes.toString('utf8')));
    if (ack.complete !== true) invalid('acknowledgment-binding', 'incomplete command');
    const acknowledgmentSha256 = await durableBlob(transport, ackBytes, process.platform);
    const resultSha256 = await durableBlob(transport, canonicalBytes({
      schemaVersion: 1, kind: 'test-runtime-result-v1', runId: entry.runId, requestSha256: entry.requestSha256,
      effectiveInvocation: entry.executionBinding.resolvedInvocation, executionBinding: entry.executionBinding,
      status: native.status, exitCode: native.exitCode, durationMs: native.durationMs,
      nativeReportBase64: report?.toString('base64') ?? null,
    }), process.platform);
    runs.push({ ordinal: entry.group.ordinal, runId: entry.runId, requestSha256: entry.requestSha256,
      anchorSha256: hash(anchor), acknowledgmentSha256, resultSha256 });
  }
  const addresses = new Set<string>([snapshot.profileSha256, snapshot.inputsSha256, dispatchSha256, hash(anchor),
    ...snapshot.entries.map((entry) => entry.blobSha256)]);
  for (const run of runs) {
    for (const address of [run.requestSha256, run.acknowledgmentSha256, run.resultSha256]) addresses.add(address);
    const ack = object(JSON.parse((await regular(join(blobDirectory(transport), run.acknowledgmentSha256))).toString('utf8')), 'blob-schema');
    for (const worker of array(ack.workerSha256s)) addresses.add(text(worker, 'blob-schema'));
  }
  const provenance: TestRuntimeProvenance = {
    kind: 'stable-test-wall-clock-v1', profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256,
    dispatchSha256, runs, publication: {
      durability: process.platform === 'win32' ? 'win32-file-flush-no-replace-rehash' : 'posix-file-directory-fsync',
      closureSha256: hash([...addresses].sort()),
    },
  };
  await publishTestRuntimeClosure({ sourceRoot: transport, controlRoot, provenance, context, platform: process.platform });
  await transportJson(join(transport, 'provenance.json'), provenance, true);
  return { ...execution, testRuntime: provenance };
}

/** @id CODE-M5-TEST-RUNTIME-PROVIDER-001
 * @implements REQ-M5-COMPAT-013 REQ-M5-LIFECYCLE-006
 * @design DES-M5-015
 */
export async function prepareTestRuntimeProvider(
  root: string,
): Promise<TestRuntimeProvider | undefined> {
  root = resolve(root);
  const rawConfig = object(JSON.parse((await regular(join(root, '.musubix/config.json'))).toString('utf8')), 'profile-digest');
  if (!Object.hasOwn(rawConfig, 'testRuntime')) return undefined;
  validateTestRuntimeProfile(rawConfig.testRuntime);
  const bridge = globalThis.__musubix5TestRuntimeCoordinator;
  if (!bridge || bridge.root !== resolve(root) || bridge.controller) invalid('reporter-missing');
  const incomingPath = process.env.MUSUBIX5_TEST_RUNTIME_REQUEST;
  const incoming = incomingPath
    ? blobSchema(JSON.parse((await regular(incomingPath)).toString('utf8'))) : undefined;
  if (Boolean(incomingPath) !== Boolean(process.env.MUSUBIX5_TEST_RUNTIME_DISPATCH)) invalid('worker-scope');
  const runId = incoming ? text(incoming.runId, 'worker-scope') : randomUUID();
  const incomingBinding = incoming ? object(incoming.executionBinding, 'augmentation-binding') : undefined;
  const incomingLocations = incomingBinding ? locations(incomingBinding.locations) : undefined;
  const run = incomingLocations?.run ?? await allocateRuntimeRun(root, runId);
  const store = incomingLocations?.['command-run'] ?? run;
  if (incomingLocations && (incomingLocations.repo !== root || incomingPath !== join(run, 'request.json')
    || process.env.MUSUBIX5_TEST_RUNTIME_DISPATCH !== join(store, 'dispatch.json'))) invalid('worker-scope');
  const snapshot = await snapshotRuntime(root, store);
  const anchor = await runtimeAnchor(root, runId);
  const provider: TestRuntimeProvider = {
    schemaVersion: 1, kind: 'test-runtime-provider-v1', executionRunId: runId,
    profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256,
    bootstrapSha256: snapshot.entries.find((e) => e.path === preloadPath)!.rawSha256,
    anchorId: hash(anchor), anchor,
  };
  const actual = { command: process.execPath, args: [join(root, 'node_modules/vitest/vitest.mjs'), ...bridge.args] };
  const runtimeReporter = `--reporter=${join(root, reporterPath)}`;
  const logical = {
    command: process.execPath,
    args: [join(root, 'node_modules/vitest/vitest.mjs'), ...bridge.args.filter((arg) => arg !== runtimeReporter)],
  };
  const selectedFiles = [...bridge.files].sort();
  const selectedTestIds = [...new Set(bridge.args.flatMap((arg) => arg.match(/TEST-[A-Z0-9-]+/g) ?? []))];
  let request: Record<string, unknown>;
  if (incoming) {
    if (incoming.kind !== 'test-runtime-request-v1' || incoming.origin !== 'configured') invalid('worker-scope');
    validateTestRuntimeExecutionBinding(incoming.executionBinding);
    equal(incoming.profileSha256, snapshot.profileSha256, 'profile-digest');
    equal(incoming.inputsSha256, snapshot.inputsSha256, 'input-hash');
    equal(incoming.selectedFiles, selectedFiles, 'acknowledgment-binding');
    equal(incoming.selectedTestIds, selectedTestIds, 'acknowledgment-binding');
    equal(observedVitestArgs(invocation(incoming.effectiveInvocation)), bridge.args, 'acknowledgment-binding');
    const dispatch = blobSchema(JSON.parse((await regular(join(store, 'dispatch.json'))).toString('utf8')));
    equal(hash(dispatch), incoming.dispatchSha256, 'acknowledgment-binding');
    if (!array(dispatch.invocations).some((value) => {
      const entry = object(value, 'acknowledgment-binding');
      return entry.runId === runId && hash(entry.executionBinding) === hash(incoming.executionBinding);
    })) invalid('acknowledgment-binding');
    request = incoming;
  } else {
    const executionBinding = augmentTestRuntimeInvocation({
      logicalInvocation: logical, profileSha256: testRuntimeProfileSha256, runId, commandRunId: runId,
      anchor, locations: { repo: root, run, 'command-run': store },
    });
    // Standalone diagnostics declare their actual argv, never runner authority.
    equal(executionBinding.resolvedInvocation, actual, 'augmentation-binding');
    const dispatch = { schemaVersion: 1, kind: 'test-runtime-dispatch-v1', commandRunId: runId,
      commandSha256: executionBinding.logicalCommandSha256, profileSha256: snapshot.profileSha256,
      inputsSha256: snapshot.inputsSha256, invocations: [{ ordinal: 0, runId,
        argv: [actual.command, ...actual.args], selectedTestIds, selectedFiles, executionBinding }] };
    const dispatchSha256 = await durableBlob(store, canonicalBytes(dispatch), process.platform);
    request = { schemaVersion: 1, kind: 'test-runtime-request-v1', runId, commandRunId: runId,
      commandName: 'test', origin: 'standalone', context: {
        repositoryId: null, changeId: null, generation: null, commit: null, role: 'standalone',
      }, configuredInvocation: actual, effectiveInvocation: actual, executionBinding,
      selectedTestIds, selectedFiles, profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256, dispatchSha256 };
    await durableBlob(store, canonicalBytes(anchor), process.platform);
    await transportJson(join(run, 'request.json'), request, true);
    await transportJson(join(store, 'dispatch.json'), dispatch, true);
  }
  const requestSha256 = await durableBlob(store, canonicalBytes(request), process.platform);
  const states = new Map(selectedFiles.map((path) => [path, 'not-started']));
  const packets = new Map<string, { digest: string; packet: Record<string, unknown> }>();
  let complete = false, reportedFailed = 0, pollingError: unknown;
  let queue = Promise.resolve();
  const update = async () => {
    for (const name of (await readdir(join(run, 'worker-acks'))).sort()) {
      if (!/^[a-f0-9-]{36}\.json$/.test(name)) invalid('unsafe-path', 'worker packet');
      if (packets.has(name)) continue;
      const bytes = await regular(join(run, 'worker-acks', name));
      const packet = blobSchema(JSON.parse(bytes.toString('utf8')));
      if (packet.kind !== 'test-runtime-worker-v1') invalid('acknowledgment-schema');
      equal(packet.runId, runId, 'acknowledgment-stale');
      equal(packet.requestSha256, requestSha256, 'acknowledgment-stale');
      const worker = object(packet.worker, 'acknowledgment-schema');
      if (!states.has(text(worker.testPath, 'acknowledgment-binding'))) invalid('acknowledgment-binding', 'foreign file');
      if ([...packets.values()].some((p) => object(p.packet.worker, 'acknowledgment-schema').testPath === worker.testPath)) {
        invalid('acknowledgment-binding', 'duplicate realm');
      }
      const digest = await durableBlob(store, bytes, process.platform);
      packets.set(name, { digest, packet });
    }
    const ordered = [...packets.values()].sort((a, b) => String(object(a.packet.worker, 'blob-schema').workerId)
      .localeCompare(String(object(b.packet.worker, 'blob-schema').workerId)));
    const ack = { schemaVersion: 1, kind: 'test-runtime-ack-v1', runId, requestSha256,
      profileSha256: snapshot.profileSha256, inputsSha256: snapshot.inputsSha256,
      nodeVersion: process.version, platform: process.platform, anchor, anchorSha256: hash(anchor),
      workers: ordered.map((p) => p.packet.worker), files: [...states].sort(([a], [b]) => a.localeCompare(b)).map(([path, state]) => ({ path, state })),
      workerSha256s: ordered.map((p) => p.digest), reporterRegistration: {
        reporterPath: join(root, reporterPath), requestSha256, observedProcess: actual, observedVitestArgs: bridge.args,
      }, reportedFailed, bootstrapErrors: [], complete };
    await transportJson(join(run, 'ack.json'), ack);
    if (complete) await durableBlob(store, canonicalBytes(ack), process.platform);
  };
  const schedule = () => { queue = queue.then(update); return queue; };
  const interval = setInterval(() => {
    if (pollingError !== undefined) return;
    void schedule().catch((cause: unknown) => { pollingError = cause; clearInterval(interval); });
  }, 250);
  interval.unref();
  bridge.controller = {
    async module(path, state) {
      const local = relative(root, path).split('\\').join('/');
      if (!states.has(local)) invalid('acknowledgment-binding', local);
      states.set(local, state);
      if (pollingError !== undefined) throw pollingError;
      await schedule();
    },
    async finish(delivered, failed) {
      clearInterval(interval);
      if (pollingError !== undefined) throw pollingError;
      equal(delivered, provider, 'acknowledgment-binding');
      for (const entry of snapshot.entries) {
        if (sha256(await regular(join(root, entry.path))) !== entry.rawSha256) invalid('input-hash', entry.path);
      }
      reportedFailed = failed;
      await schedule();
      if (packets.size !== states.size || [...states.values()].some((state) => !['completed', 'failed', 'skipped'].includes(state))) {
        invalid('acknowledgment-binding', 'incomplete native inventory');
      }
      complete = true;
      await schedule();
    },
  };
  await schedule();
  bridge.configureEnvironment({ MUSUBIX5_TEST_RUNTIME_REQUEST: join(run, 'request.json'),
    MUSUBIX5_TEST_RUNTIME_DISPATCH: join(store, 'dispatch.json') });
  return Object.freeze({ ...provider, anchor: Object.freeze(anchor) });
}
