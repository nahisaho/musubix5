/** @id CODE-M5-CI-CANDIDATE-PRECONDITION-PROBE-001
 * @implements REQ-M5-CI-008
 * @design DES-M5-CI-008
 */
import { pathToFileURL } from 'node:url';
import { resolve, join } from 'node:path';
import { readFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';

const [operation, root, commit, phase] = process.argv.slice(2);

try {
  const workspace = await import(pathToFileURL(
    resolve(root, 'dist/packages/analysis/src/workspace-manager.js'),
  ).href);
  if (operation === 'lfs') {
    await workspace.verifyCandidateLfsClosure(root, commit, 'local');
  } else if (operation === 'prepared-lfs') {
    const hash = bytes => createHash('sha256').update(bytes).digest('hex');
    const manifest = JSON.parse(await readFile(phase, 'utf8'));
    const portability = await import(pathToFileURL(resolve(root, 'dist/packages/analysis/src/candidate-portability.js')).href);
    portability.verifyCandidateLfsClosureManifest(manifest, {
      nonce: process.env.CANDIDATE_DISPATCH_NONCE, runId: process.env.GITHUB_RUN_ID, runAttempt: Number(process.env.GITHUB_RUN_ATTEMPT),
      repositoryId: process.env.REPOSITORY_ID, candidateCommit: commit,
      jobTimingDigest: process.env.CANDIDATE_JOB_TIMING_DIGEST, digest: process.argv[6],
      scriptDigest: hash(await readFile(join(root, 'scripts/verify-lfs-checkout.mjs'))),
      configDigest: hash(await readFile(join(root, '.musubix/config.json'))),
    });
    const remaining = () => {
      const value = Number(process.env.CANDIDATE_JOB_STARTED_AT) + (process.env.CANDIDATE_MODE === 'calibration' ? 1_980_000 : 1_080_000) - Date.now();
      if (!Number.isSafeInteger(value) || value <= 0) throw new Error('CANDIDATE_ABSOLUTE_DEADLINE');
      return Math.min(value, 60_000);
    };
    const git = (args, input) => execFileSync('git', args, { cwd: root, input, timeout: remaining(), maxBuffer: 16_000_000, encoding: 'utf8' });
    const observed = git(['cat-file', '--batch-check=%(objectname) %(objecttype)'], `${manifest.objects.join('\n')}\n`).trim().split('\n');
    if (observed.length !== manifest.objects.length || observed.some((line, index) =>
      !new RegExp(`^${manifest.objects[index]} (?:blob|tree|commit|tag)$`).test(line))) throw new Error('CANDIDATE_LFS_CLOSURE_MANIFEST_INVALID');
    const common = resolve(root, git(['rev-parse', '--git-common-dir']).trim());
    for (const pointer of manifest.pointers) {
      const bytes = await readFile(join(common, 'lfs/objects', pointer.oid.slice(0, 2), pointer.oid.slice(2, 4), pointer.oid));
      if (bytes.length !== pointer.size || hash(bytes) !== pointer.oid) throw new Error('TDD_SOURCE_LFS_INVALID: local-object-corrupt');
    }
  } else if (operation === 'tree' && (phase === 'pre' || phase === 'post')) {
    console.log(await workspace.compareTrackedTree(root, commit, phase));
  } else {
    throw new Error('Candidate gate precondition probe input invalid.');
  }
} catch (error) {
  console.log(JSON.stringify({ code: error?.code, message: error?.message }));
  process.exitCode = 1;
}
