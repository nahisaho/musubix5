export interface CandidateGateCommandOutcome {
  stdoutPath: string;
  stderrPath: string;
  stdoutTail: string;
  stderrTail: string;
  stdoutSha256: string;
  stderrSha256: string;
  tailsDropped: boolean;
  resultTextDropped: boolean;
  exitCode: number | null;
  signal: string | null;
  timedOut: boolean;
}

const candidateStreamLimit = 100_000_000;
const candidateCarryLimit = 8192;
const candidateTailLimit = 20000;
const stripAnsi = (text: string) => text.replace(/\u001b\[[0-?]*[ -/]*[@-~]/g, '');

function secretRepresentations(secrets: readonly string[]): string[] {
  return [...new Set(secrets.filter(Boolean).flatMap((secret) => {
    const plain = stripAnsi(secret);
    return [secret, plain, JSON.stringify(secret), JSON.stringify(secret).slice(1, -1),
      JSON.stringify(plain), JSON.stringify(plain).slice(1, -1)];
  }))].sort((a, b) => b.length - a.length);
}

function redactCandidateText(text: string, representations: readonly string[]): { text: string; unsafe: boolean } {
  text = stripAnsi(text);
  const candidates = [...text.matchAll(/(?:github_pat_|gh[opsur]_)[A-Za-z0-9_]+|\bauthorization\s*:\s*[^\r\n]*/gi)];
  if (representations.some((value) => value.length > candidateCarryLimit)
    || candidates.some((match) => match[0].length > candidateCarryLimit)) return { text: '', unsafe: true };
  for (const secret of representations) text = text.split(secret).join('[REDACTED]');
  text = text.replace(/(?:github_pat_|gh[opsur]_)[A-Za-z0-9_]+/g, '[REDACTED]')
    .replace(/(\bauthorization\s*:\s*)[^\r\n]*/gi, '$1[REDACTED]');
  return { text, unsafe: false };
}

class CandidateTailRedactor {
  private carry = '';
  tail = '';
  dropped = false;
  unsafe: boolean;

  constructor(private readonly representations: readonly string[]) {
    this.unsafe = representations.some((value) => value.length > candidateCarryLimit);
  }

  append(text: string, final = false): void {
    if (this.unsafe) return;
    this.carry = stripAnsi(this.carry + text);
    if (redactCandidateText(this.carry, this.representations).unsafe) {
      this.unsafe = true;
      this.tail = this.carry = '';
      return;
    }
    let cut = final ? this.carry.length : Math.max(0, this.carry.length - candidateCarryLimit);
    const ranges: Array<{ start: number; end: number }> = [];
    for (const secret of this.representations) {
      for (let at = this.carry.indexOf(secret); at >= 0; at = this.carry.indexOf(secret, at + 1)) {
        ranges.push({ start: at, end: at + secret.length });
      }
    }
    for (const match of this.carry.matchAll(/(?:github_pat_|gh[opsur]_)[A-Za-z0-9_]+|\bauthorization\s*:\s*[^\r\n]*/gi)) {
      ranges.push({ start: match.index, end: match.index + match[0].length });
    }
    for (const range of ranges) if (range.start < cut && range.end > cut) cut = Math.max(cut, range.end);
    const partialAnsi = this.carry.lastIndexOf('\u001b');
    if (!final && partialAnsi >= 0 && !/^\u001b\[[0-?]*[ -/]*[@-~]/.test(this.carry.slice(partialAnsi))) {
      cut = Math.min(cut, partialAnsi);
    }
    if (!final && this.carry.length - cut > candidateCarryLimit) {
      this.unsafe = true;
      this.tail = this.carry = '';
      return;
    }
    const safe = redactCandidateText(this.carry.slice(0, cut), this.representations);
    this.carry = this.carry.slice(cut);
    const combined = this.tail + safe.text;
    this.dropped ||= combined.length > candidateTailLimit;
    this.tail = combined.slice(-candidateTailLimit);
  }
}

/** @id CODE-M5-CI-CANDIDATE-CAPTURE-001
 * @implements REQ-M5-CI-008
 * @design DES-M5-CI-008
 */
export async function runCandidateGateCommand(input: {
  command: string; args: string[]; cwd: string; temporaryDirectory: string;
  timeoutMs: number; secrets: readonly string[]; env?: NodeJS.ProcessEnv;
}): Promise<CandidateGateCommandOutcome> {
  if (!Number.isSafeInteger(input.timeoutMs) || input.timeoutMs <= 0 || input.timeoutMs > 300000) {
    throw new Error('CANDIDATE_GATE_REPORT_INVALID: invalid subprocess timeout.');
  }
  await mkdir(input.temporaryDirectory, { recursive: true });
  for (let path = resolve(input.temporaryDirectory); path !== dirname(path); path = dirname(path)) {
    const stat = await lstat(path);
    if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error('CANDIDATE_GATE_REPORT_INVALID: unsafe spool directory.');
  }
  const directory = await mkdtemp(join(input.temporaryDirectory, 'musubix5-gate-'));
  const stdoutPath = join(directory, 'stdout'), stderrPath = join(directory, 'stderr');
  const flags = constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | (constants.O_NOFOLLOW ?? 0);
  const stdoutFile = await open(stdoutPath, flags, 0o600);
  let stderrFile: typeof stdoutFile;
  try { stderrFile = await open(stderrPath, flags, 0o600); }
  catch (cause) {
    await stdoutFile.close();
    await rm(directory, { recursive: true, force: true });
    throw cause;
  }
  const representations = secretRepresentations(input.secrets);
  const stdoutTail = new CandidateTailRedactor(representations), stderrTail = new CandidateTailRedactor(representations);
  const stdoutHash = createHash('sha256'), stderrHash = createHash('sha256');
  let timedOut = false, capped = false;
  const child = spawn(input.command, input.args, { cwd: input.cwd, env: input.env ?? process.env,
    shell: false, stdio: ['ignore', 'pipe', 'pipe'], detached: process.platform !== 'win32' });
  const terminate = () => {
    if (child.pid && process.platform !== 'win32') {
      try { process.kill(-child.pid, 'SIGKILL'); }
      catch (cause) {
        if (!(cause instanceof Error && 'code' in cause && cause.code === 'ESRCH')) throw cause;
      }
    } else child.kill('SIGKILL');
  };
  const timer = setTimeout(() => { timedOut = true; terminate(); }, input.timeoutMs);
  const completed = new Promise<{ exitCode: number | null; signal: string | null }>((accept) => {
    child.once('error', () => accept({ exitCode: 1, signal: null }));
    child.once('close', (exitCode, signal) => accept({ exitCode, signal }));
  });
  const pump = async (stream: typeof child.stdout, file: typeof stdoutFile, hash: typeof stdoutHash, redactor: CandidateTailRedactor) => {
    let size = 0;
    const decoder = new StringDecoder('utf8');
    for await (const value of stream) {
      const bytes: Buffer = Buffer.isBuffer(value) ? value : Buffer.from(value);
      hash.update(bytes);
      redactor.append(decoder.write(bytes));
      const retained = Math.min(bytes.length, candidateStreamLimit - size);
      if (retained > 0) {
        let offset = 0;
        while (offset < retained) {
          const { bytesWritten } = await file.write(bytes, offset, retained - offset);
          if (!bytesWritten) throw new Error('CANDIDATE_GATE_REPORT_INVALID: incomplete spool write.');
          offset += bytesWritten;
        }
      }
      size += retained;
      if (retained !== bytes.length) { capped = true; terminate(); }
    }
    redactor.append(decoder.end(), true);
  };
  try {
    const [result] = await Promise.all([completed, pump(child.stdout, stdoutFile, stdoutHash, stdoutTail),
      pump(child.stderr, stderrFile, stderrHash, stderrTail)]);
    const unsafe = capped || stdoutTail.unsafe || stderrTail.unsafe;
    return {
      stdoutPath, stderrPath, stdoutTail: unsafe ? '' : stdoutTail.tail, stderrTail: unsafe ? '' : stderrTail.tail,
      stdoutSha256: stdoutHash.digest('hex'), stderrSha256: stderrHash.digest('hex'),
      tailsDropped: unsafe || stdoutTail.dropped || stderrTail.dropped, resultTextDropped: unsafe,
      exitCode: capped ? 1 : result.exitCode, signal: capped ? null : result.signal, timedOut,
    };
  } catch (cause) {
    terminate();
    await rm(directory, { recursive: true, force: true });
    throw cause;
  } finally {
    clearTimeout(timer);
    await stdoutFile.close();
    await stderrFile.close();
  }
}

interface NormalizedCandidateCheck {
  name: string; required: boolean; status: 'pass' | 'fail' | 'skipped';
  summary: string; exitCode?: number | null; stdout?: string; stderr?: string;
  diagnostics?: Array<{ code: string; severity: 'error' | 'warning' | 'info'; message: string; path?: string }>;
}

function candidateObject(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

function candidateCheck(value: unknown): value is NormalizedCandidateCheck {
  return candidateObject(value) && typeof value.name === 'string' && /^[a-z][a-z0-9:.-]{0,127}$/.test(value.name)
    && typeof value.required === 'boolean' && ['pass', 'fail', 'skipped'].includes(String(value.status))
    && typeof value.summary === 'string'
    && (value.exitCode === undefined || value.exitCode === null || Number.isInteger(value.exitCode))
    && (value.stdout === undefined || typeof value.stdout === 'string')
    && (value.stderr === undefined || typeof value.stderr === 'string')
    && (value.diagnostics === undefined || Array.isArray(value.diagnostics) && value.diagnostics.every((diagnostic) =>
      candidateObject(diagnostic) && typeof diagnostic.code === 'string' && /^[A-Z][A-Z0-9_]{0,127}$/.test(diagnostic.code)
      && ['error', 'warning', 'info'].includes(String(diagnostic.severity)) && typeof diagnostic.message === 'string'
      && (diagnostic.path === undefined || typeof diagnostic.path === 'string')));
}

/** @id CODE-M5-CI-CANDIDATE-NORMALIZER-001
 * @implements REQ-M5-CI-008
 * @design DES-M5-CI-008
 */
export async function normalizeCandidateGateReport(outcome: CandidateGateCommandOutcome, options: {
  resultPath: string; context: CandidateGateContext & { job: { os: string; nodeMajor: number } };
  secrets: readonly string[]; preTreeMatchesCandidate?: boolean; postTreeMatchesCandidate?: boolean;
}) {
  const context = options.context;
  if (!/^repository:[a-f0-9]{64}$/.test(context.repositoryId) || !/^CHANGE-\d+$/.test(context.changeId)
    || !Number.isSafeInteger(context.generation) || context.generation <= 0
    || !/^[a-f0-9]{40}$/.test(context.candidateCommit) || !/^[a-f0-9]{64}$/.test(context.gateInputFingerprint)
    || !['ubuntu', 'windows', 'macos'].includes(context.job.os) || context.job.nodeMajor !== 24) {
    throw new Error('CANDIDATE_GATE_REPORT_INVALID: invalid candidate context.');
  }
  const representations = secretRepresentations(options.secrets);
  let omitText = outcome.resultTextDropped || representations.some((value) => value.length > candidateCarryLimit);
  const safeText = (text: string): string => {
    const result = redactCandidateText(text, representations);
    omitText ||= result.unsafe;
    return result.text.slice(-candidateTailLimit);
  };
  let parsed: unknown, classification: string | undefined, originalCode: string | undefined, originalMessage: string | undefined;
  let checks: NormalizedCandidateCheck[] = [];
  try {
    const stat = await lstat(outcome.stdoutPath);
    if (!stat.isFile() || stat.isSymbolicLink() || stat.size > candidateStreamLimit) {
      classification = 'malformed-json';
    } else {
      const file = await open(outcome.stdoutPath, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
      let raw: Buffer;
      try { raw = await file.readFile(); }
      finally { await file.close(); }
      if (sha256(raw) !== outcome.stdoutSha256) { classification = 'malformed-json'; omitText = true; }
      else if (!raw.length) classification = 'empty-stdout';
      else {
        try { parsed = JSON.parse(raw.toString('utf8')); }
        catch (cause) {
          if (!(cause instanceof SyntaxError)) throw cause;
          classification = 'malformed-json';
        }
      }
    }
    if (outcome.timedOut) classification = 'timeout';
    else if (outcome.signal) classification = 'signal';
    else if (!classification) {
      if (!candidateObject(parsed)) classification = 'invalid-root';
      else if ('error' in parsed) {
        classification = 'cli-error';
        const envelope = parsed.error;
        if (candidateObject(envelope)) {
          if (typeof envelope.code === 'string' && /^[A-Z][A-Z0-9_]{0,127}$/.test(envelope.code)) originalCode = safeText(envelope.code);
          if (typeof envelope.message === 'string') originalMessage = safeText(envelope.message);
        } else if (typeof envelope === 'string') originalMessage = safeText(envelope);
      } else if (!('checks' in parsed)) classification = 'missing-checks';
      else if (!Array.isArray(parsed.checks)) classification = 'non-array-checks';
      else if (parsed.checks.length > 10000 || !parsed.checks.every(candidateCheck)) classification = 'invalid-check';
      else checks = parsed.checks;
    }
    const sanitizedChecks = checks.map((check) => ({
      name: safeText(check.name), required: check.required, status: check.status, summary: safeText(check.summary),
      ...(check.diagnostics ? { diagnostics: check.diagnostics.map((diagnostic) => ({
        code: safeText(diagnostic.code), severity: diagnostic.severity, message: safeText(diagnostic.message),
        ...(diagnostic.path ? { path: safeText(diagnostic.path) } : {}),
      })) } : {}),
    }));
    const commands = checks.filter((check) => check.name.startsWith('command:')).map((check) => ({
      name: safeText(check.name.slice('command:'.length)), exitCode: check.exitCode ?? -1,
      digest: sha256(canonicalBytes({ name: check.name.slice('command:'.length), exitCode: check.exitCode ?? -1,
        stdout: check.stdout ?? '', stderr: check.stderr ?? '' })), status: check.status === 'pass' ? 'pass' as const : 'fail' as const,
    }));
    const commandsPassed = !classification && !omitText && outcome.exitCode === 0
      && checks.every((check) => !check.required || check.name === 'approval' || check.status === 'pass')
      && commands.length === requiredCandidateGateCommands.length
      && [...commands.map((command) => command.name)].sort().join('\n') === [...requiredCandidateGateCommands].sort().join('\n')
      && commands.every((command) => command.status === 'pass');
    if (!classification && outcome.exitCode !== 0) classification = 'non-zero-exit';
    if (outcome.resultTextDropped && outcome.exitCode !== 0 && !outcome.timedOut && !outcome.signal) classification = 'non-zero-exit';
    const stdoutTail = safeText(outcome.stdoutTail), stderrTail = safeText(outcome.stderrTail);
    if (omitText && !classification) classification = 'redaction-unavailable';
    const pass = commandsPassed && options.preTreeMatchesCandidate === true && options.postTreeMatchesCandidate === true && !omitText;
    const result = {
      schemaVersion: 1, ...options.context, producer: 'github-actions', runtime: options.context.job,
      commands: omitText ? [] : commands, commandsPassed: commandsPassed && !omitText,
      preTreeMatchesCandidate: options.preTreeMatchesCandidate === true, postTreeMatchesCandidate: options.postTreeMatchesCandidate === true,
      gateReportDigest: outcome.stdoutSha256, status: pass ? 'pass' as const : 'fail' as const,
      stdoutSha256: outcome.stdoutSha256, stderrSha256: outcome.stderrSha256,
      exitCode: outcome.exitCode, signal: outcome.signal, timedOut: outcome.timedOut,
      tailsDropped: outcome.tailsDropped || omitText, resultTextDropped: omitText,
      ...(!omitText ? { stdoutTail, stderrTail, checks: sanitizedChecks } : {}),
      ...(classification ? { error: { code: 'CANDIDATE_GATE_REPORT_INVALID', case: classification,
        ...(!omitText && originalCode ? { originalCode } : {}), ...(!omitText && originalMessage ? { originalMessage } : {}) } } : {}),
    };
    const resultFile = await open(options.resultPath,
      constants.O_WRONLY | constants.O_CREAT | constants.O_TRUNC | (constants.O_NOFOLLOW ?? 0), 0o600);
    try {
      await resultFile.writeFile(canonicalBytes(result));
      await resultFile.sync();
    } finally { await resultFile.close(); }
    return result;
  } finally {
    await rm(outcome.stdoutPath, { force: true });
    await rm(outcome.stderrPath, { force: true });
    if (dirname(outcome.stdoutPath) === dirname(outcome.stderrPath)
      && dirname(outcome.stdoutPath).split(/[\\/]/).at(-1)?.startsWith('musubix5-gate-')) {
      await rm(dirname(outcome.stdoutPath), { recursive: true, force: true });
    }
  }
}

