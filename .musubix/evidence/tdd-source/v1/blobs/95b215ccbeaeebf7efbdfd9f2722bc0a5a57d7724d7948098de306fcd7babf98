import { describe,expect,it } from 'vitest';
import type { ChangeFingerprints,ChangePhaseEvidence,ChangeTddBatch } from '../packages/analysis/src/change-evidence.js';
import { canonicalBytes,sha256 } from '../packages/analysis/src/canonical.js';
import { execFileSync } from 'node:child_process';
import { mkdirSync,mkdtempSync,readFileSync,rmSync,writeFileSync } from 'node:fs';
import { join,resolve } from 'node:path';

const fingerprints: ChangeFingerprints={
  impact: 'impact',
  requirements: 'requirements',
  design: 'design',
  implementation: 'implementation',
  tests: 'tests',
  tdd: 'tdd',
};

function phase(name: 'red'|'implementation'|'green',order: number): ChangePhaseEvidence {
  return { phase: name,order,recordedAt: new Date(order).toISOString(),fingerprints };
}

describe('TDD batch recording',() => {
  /** @id TEST-M5-CHECKPOINT-STATUS-001
   * @verifies REQ-M5-LIFECYCLE-006
   * @design DES-M5-007 DES-M5-015
   */
  it('TEST-M5-CHECKPOINT-STATUS-001 exposes historical legacy gaps and fails closed for parseable invalid checkpoints without writing projections',async () => {
    mkdirSync(resolve('.musubix/cache'),{ recursive: true });
    const root=mkdtempSync(resolve('.musubix/cache/checkpoint-status-'));
    try {
      execFileSync('git',['init','--quiet',root]);
      const { defaultConfig }=await import('../packages/analysis/src/config.js');
      const { projectStatus }=await import('../packages/analysis/src/gate.js');
      const { validateChangeEvidence }=await import('../packages/analysis/src/change.js');
      const journal=await import('../packages/analysis/src/journal.js');
      const order=await import('../packages/analysis/src/order.js');
      const key='REQ-M5-LIFECYCLE-006';
      mkdirSync(join(root,'.musubix/changes'),{ recursive: true });
      mkdirSync(join(root,'.musubix/evidence'),{ recursive: true });
      writeFileSync(join(root,'.musubix/config.json'),JSON.stringify(defaultConfig));
      writeFileSync(join(root,'.musubix/changes/CHANGE-0017.md'),`# CHANGE-0017\nRequirements: ${key}\n`);
      const projection=JSON.stringify({
        schemaVersion: 1,changes: [{
          changeId: 'CHANGE-0017',generation: 5,activeGeneration: 5,requirementIds: [key],phases: {},
          generationHistory: [{ generation: 4,status: 'abandoned',requirementIds: [key],phases: {} }],
        }]
      });
      writeFileSync(join(root,'.musubix/evidence/changes.json'),projection);
      await order.appendEvidenceOrder(root,{ kind: 'change',entityId: 'CHANGE-0017',phase: 'g4:green' });
      const legacy=await projectStatus(root);
      expect(legacy.change!.generations).toMatchObject([
        { generation: 4,unprojectedBatchCheckpoints: [{ phase: 'green',scopeId: null,recovery: 'legacy' }] },
        { generation: 5,unprojectedBatchCheckpoints: [] },
      ]);
      expect(legacy.changeDiagnostics.some((entry) => entry.code==='CHANGE_CHECKPOINT_JOURNAL_INVALID')).toBe(false);
      await order.appendEvidenceOrder(root,{ kind: 'change',entityId: 'CHANGE-0017',phase: 'g5:red' });
      await journal.appendJournalRecord(root,{
        stream: 'normal',changeId: 'CHANGE-0017',kind: 'change-batch-checkpoint',
        idempotencyKey: 'change-batch-checkpoint:CHANGE-0017:g5:red',
        payload: { changeId: 'CHANGE-0017',generation: 5,phase: 'red' },
      });
      const invalid=await projectStatus(root);
      expect(invalid.change!.generations[1]).toMatchObject({
        unprojectedBatchCheckpoints: [{ phase: 'red',scopeId: null,recovery: 'invalid' }],
      });
      expect(invalid.gate!.ready).toBe(false);
      expect(invalid.changeDiagnostics.some((entry) => entry.code==='CHANGE_CHECKPOINT_JOURNAL_INVALID')).toBe(true);
      expect((await validateChangeEvidence(root)).diagnostics.some((entry) => entry.code==='CHANGE_CHECKPOINT_JOURNAL_INVALID')).toBe(true);
      expect(readFileSync(join(root,'.musubix/evidence/changes.json'),'utf8')).toBe(projection);
    } finally {
      rmSync(root,{ recursive: true,force: true });
    }
  });

  /** @id TEST-M5-CHECKPOINT-LIFECYCLE-001
   * @verifies REQ-M5-LIFECYCLE-006
   * @design DES-M5-004 DES-M5-022
   */
  it('TEST-M5-CHECKPOINT-LIFECYCLE-001 keeps concurrent lifecycle projections and accepts already-held recovery handles',async () => {
    mkdirSync(resolve('.musubix/cache'),{ recursive: true });
    const root=mkdtempSync(resolve('.musubix/cache/checkpoint-lifecycle-'));
    try {
      execFileSync('git',['init','--quiet',root]);
      const { defaultConfig }=await import('../packages/analysis/src/config.js');
      const changes=await import('../packages/analysis/src/change.js');
      const journal=await import('../packages/analysis/src/journal.js');
      mkdirSync(join(root,'.musubix/changes'),{ recursive: true });
      writeFileSync(join(root,'.musubix/config.json'),JSON.stringify(defaultConfig));
      for(const id of ['CHANGE-0017','CHANGE-0018']) {
        writeFileSync(join(root,`.musubix/changes/${id}.md`),`# ${id}\nRequirements: REQ-M5-LIFECYCLE-006\n`);
      }
      await Promise.all(['CHANGE-0017','CHANGE-0018'].map((id) =>
        changes.recordChangePhase(root,id,'impact',['REQ-M5-LIFECYCLE-006'])));
      expect((await changes.loadChangeEvidence(root))!.changes.map((entry) => entry.changeId).sort())
        .toEqual(['CHANGE-0017','CHANGE-0018']);
      const api=changes as unknown as {
        reconcilePendingPhaseCheckpoints(root: string,id: string,leases: import('../packages/analysis/src/journal.js').ChangeProjectionAppendLeaseSet): Promise<{ recoveredPhaseCheckpoints: number }>;
      };
      await journal.withChangeProjectionLeases(root,['CHANGE-0017'],(leases) =>
        journal.withOrderLease(root,async (appendSession) => {
          expect(await api.reconcilePendingPhaseCheckpoints(root,'CHANGE-0017',{ ...leases,appendSession }))
            .toEqual({ recoveredPhaseCheckpoints: 0 });
          await expect(api.reconcilePendingPhaseCheckpoints(root,'CHANGE-0018',{ ...leases,appendSession }))
            .rejects.toThrow('LEASE_FENCED');
        },leases));
    } finally {
      rmSync(root,{ recursive: true,force: true });
    }
  });

  /** @id TEST-M5-CHECKPOINT-RECOVERY-001
   * @verifies REQ-M5-LIFECYCLE-006
   * @design DES-M5-004 DES-M5-007 DES-M5-022
   */
  it('TEST-M5-CHECKPOINT-RECOVERY-001 replays journal-only and ordered checkpoints without adopting legacy or rewriting caller bindings',async () => {
    mkdirSync(resolve('.musubix/cache'),{ recursive: true });
    const root=mkdtempSync(resolve('.musubix/cache/checkpoint-recovery-'));
    try {
      execFileSync('git',['init','--quiet',root]);
      const journal=await import('../packages/analysis/src/journal.js');
      const tdd=await import('../packages/analysis/src/tdd.js');
      const order=await import('../packages/analysis/src/order.js');
      type Payload=import('../packages/analysis/src/change-evidence.js').BatchCheckpointPayload;
      type LeaseSet=import('../packages/analysis/src/journal.js').ChangeProjectionAppendLeaseSet;
      type Session=import('../packages/analysis/src/journal.js').AppendLeaseSession;
      const api=tdd as unknown as {
        appendBatchCheckpoint(root: string,payload: Payload,session?: Session): Promise<import('../packages/analysis/src/journal.js').JournalRecord>;
        recoverBatchCheckpoints(root: string,changeId: string,leases: LeaseSet): Promise<{ recoveredBatchCheckpoints: number }>;
      };
      const key='REQ-M5-LIFECYCLE-006';
      const fp=Object.fromEntries(Object.keys(fingerprints).map((name) => [name,'b'.repeat(64)])) as unknown as ChangeFingerprints;
      const change={
        changeId: 'CHANGE-0017',generation: 5,activeGeneration: 5,
        requirementIds: [key,'REQ-M5-TDD-003'],
        phases: { design: { phase: 'design',order: 1,recordedAt: '2026-09-27T00:00:00.000Z',fingerprints: fp } },
        tddBatches: [],
      };
      mkdirSync(join(root,'.musubix/evidence'),{ recursive: true });
      writeFileSync(join(root,'.musubix/evidence/changes.json'),JSON.stringify({ schemaVersion: 1,changes: [change] }));
      await order.appendEvidenceOrder(root,{ kind: 'change',entityId: change.changeId,phase: 'g5:design' });
      await order.appendEvidenceOrder(root,{ kind: 'change',entityId: change.changeId,phase: `g4:green:${key}` });
      const payload: Payload={
        schemaVersion: 1,changeId: change.changeId,generation: 5,phase: 'red',scopeId: key,
        repositoryId: 'repository:'+'a'.repeat(64),workspaceHead: 'a'.repeat(40),
        requirementIds: [key],fingerprints: fp,workspaceStateSha256: 'c'.repeat(64),tddEvidenceSha256: 'd'.repeat(64),
        semanticPhaseKey: `g5:red:${key}`,orderPhaseKey: `g5:red:${key}`,
        recordedAt: '2026-09-27T00:00:00.000Z',changeFencingToken: 2,projectionFencingToken: 3,
      };
      const first=await api.appendBatchCheckpoint(root,payload);
      expect(await api.appendBatchCheckpoint(root,{ ...payload,recordedAt: '2026-09-27T01:00:00.000Z',changeFencingToken: 99 })).toEqual(first);
      await expect(api.appendBatchCheckpoint(root,{ ...payload,workspaceHead: 'e'.repeat(40) }))
        .rejects.toThrow('CHANGE_GENERATION_DUPLICATE');
      await journal.withChangeProjectionLeases(root,[change.changeId],async (leases) => {
        await journal.withOrderLease(root,async (session) => {
          const held={ ...leases,appendSession: session };
          expect(await api.recoverBatchCheckpoints(root,change.changeId,held)).toEqual({ recoveredBatchCheckpoints: 1 });
          expect(await api.recoverBatchCheckpoints(root,change.changeId,held)).toEqual({ recoveredBatchCheckpoints: 0 });
          const implementation: Payload={
            ...payload,phase: 'implementation',semanticPhaseKey: `g5:implementation:${key}`,orderPhaseKey: `g5:implementation:${key}`,
          };
          await api.appendBatchCheckpoint(root,implementation,session);
          await order.appendEvidenceOrder(root,{ kind: 'change',entityId: change.changeId,phase: implementation.orderPhaseKey },session);
          expect(await api.recoverBatchCheckpoints(root,change.changeId,held)).toEqual({ recoveredBatchCheckpoints: 1 });
          await expect(api.recoverBatchCheckpoints(root,'CHANGE-9999',held)).rejects.toThrow('LEASE_FENCED');
        },leases);
      });
      const projected=JSON.parse(readFileSync(join(root,'.musubix/evidence/changes.json'),'utf8')).changes[0];
      expect(projected.tddBatches).toHaveLength(1);
      expect(projected.tddBatches[0].red.recordedAt).toBe(payload.recordedAt);
      expect(projected.tddBatches[0].red.fingerprints).toEqual(fp);
      expect(projected.tddBatches[0].red.order).toBe(3);
      expect(projected.tddBatches[0].implementation.order).toBe(4);
      expect(projected.tddBatches[0].green).toBeUndefined();
      expect((await journal.loadJournalRecords(root))).toHaveLength(2);
      expect((await order.loadEvidenceOrder(root))!.records).toHaveLength(4);
    } finally {
      rmSync(root,{ recursive: true,force: true });
    }
  });

  /** @id TEST-M5-CHECKPOINT-REGISTRY-001
   * @verifies REQ-M5-LIFECYCLE-006
   * @design DES-M5-007 DES-M5-022
   */
  it('TEST-M5-CHECKPOINT-REGISTRY-001 validates exact journal bindings and classifies duplicate, interrupted and immutable legacy gaps',async () => {
    const registry=await import('../packages/analysis/src/change-evidence.js');
    const key='REQ-M5-LIFECYCLE-006';
    expect(registry.nextBatchScopeId([
      { scopeId: `${key}#4`,requirementIds: [key] },
      { scopeId: key,requirementIds: [key] },
      { scopeId: `${key}#4`,requirementIds: [key] },
    ],[key])).toBe(`${key}#5`);
    type Record=import('../packages/analysis/src/journal.js').JournalRecord;
    type Change=import('../packages/analysis/src/change-evidence.js').ChangeRecord;
    type Order=import('../packages/analysis/src/order.js').EvidenceOrderLog;
    const api=registry as unknown as {
      validateBatchCheckpointJournal(records: Record[],changes?: Change[]): { valid: boolean; records: Record[]; diagnostics: { code: string }[] };
      inspectBatchCheckpointGaps(change: Change,records: Record[],order: Order): {
        entries: { order: number; generation: number; phase: string; scopeId: string|null; recovery: string }[];
        diagnostics: { code: string }[];
      };
    };
    const change: Change={
      changeId: 'CHANGE-0017',generation: 5,activeGeneration: 5,
      requirementIds: [key,'REQ-M5-TDD-003'],phases: {},
      tddBatches: [{ scopeId: key,requirementIds: [key],red: phase('red',3275) }],
      generationHistory: [{
        generation: 4,status: 'abandoned',requirementIds: [key],phases: {},
        tddBatches: [{ scopeId: key,requirementIds: [key],red: phase('red',3270) }],
      }],
    };
    const payload={
      schemaVersion: 1,changeId: change.changeId,generation: 5,phase: 'implementation',
      scopeId: key,repositoryId: 'https://github.com/example/repository',workspaceHead: 'a'.repeat(40),
      requirementIds: [key],fingerprints: Object.fromEntries(Object.keys(fingerprints).map((name) => [name,'b'.repeat(64)])),
      workspaceStateSha256: 'c'.repeat(64),tddEvidenceSha256: 'd'.repeat(64),
      semanticPhaseKey: `g5:implementation:${key}`,orderPhaseKey: `g5:implementation:${key}`,
      recordedAt: '2026-09-27T00:00:00.000Z',changeFencingToken: 1,projectionFencingToken: 2,
    };
    const envelope={
      schemaVersion: 1 as const,order: 1,stream: 'normal' as const,
      changeId: change.changeId,kind: 'change-batch-checkpoint',
      idempotencyKey: `change-batch-checkpoint:${change.changeId}:g5:implementation:${key}`,
      payload,previousSha256: null,
    };
    const record: Record={ ...envelope,recordSha256: sha256(canonicalBytes(envelope)) };
    expect(api.validateBatchCheckpointJournal([record],[change]).valid).toBe(true);
    for(const mutation of [
      { extra: true },{ scopeId: `${key}#01` },{ changeFencingToken: 0 },
      { semanticPhaseKey: 'g5:red' },{ requirementIds: [key,key] },
      { requirementIds: change.requirementIds },
    ]) {
      const bad={ ...envelope,payload: { ...payload,...mutation } };
      const result=api.validateBatchCheckpointJournal([{ ...bad,recordSha256: sha256(canonicalBytes(bad)) }],[change]);
      expect(result.valid).toBe(false);
      expect(result.diagnostics.some((entry) => entry.code==='CHANGE_CHECKPOINT_JOURNAL_INVALID')).toBe(true);
    }
    expect(api.validateBatchCheckpointJournal([record,record],[change]).valid).toBe(false);
    const order: Order={
      schemaVersion: 1,
      records: [
        { sequence: 3274,phase: `g4:green:${key}` },
        { sequence: 3275,phase: `g5:red:${key}` },
        { sequence: 3276,phase: `g5:implementation:${key}` },
        { sequence: 3277,phase: `g5:red:${key}` },
        { sequence: 3278,phase: 'g5:green' },
        { sequence: 3279,phase: `g05:red:${key}` },
        { sequence: 3280,phase: `g5:superseded-red:${key}` },
      ].map((entry) => ({ ...entry,kind: 'change',entityId: change.changeId,previousSha256: null,recordSha256: 'e'.repeat(64) })),
    };
    const gaps=api.inspectBatchCheckpointGaps(change,[record],order);
    expect(gaps.entries).toEqual([
      { changeId: change.changeId,generation: 4,scopeId: key,phase: 'green',order: 3274,recovery: 'legacy' },
      { changeId: change.changeId,generation: 5,scopeId: key,phase: 'red',order: 3275,recovery: 'invalid' },
      { changeId: change.changeId,generation: 5,scopeId: key,phase: 'implementation',order: 3276,recovery: 'interrupted' },
      { changeId: change.changeId,generation: 5,scopeId: key,phase: 'red',order: 3277,recovery: 'invalid' },
      { changeId: change.changeId,generation: 5,scopeId: null,phase: 'green',order: 3278,recovery: 'legacy' },
    ]);
    expect(gaps.diagnostics.map((entry) => entry.code)).toContain('EVIDENCE_ORDER_SCHEMA');
    expect(gaps.diagnostics.map((entry) => entry.code)).toContain('CHANGE_CHECKPOINT_JOURNAL_INVALID');
    expect(change.generationHistory![0]!.tddBatches![0]!.green).toBeUndefined();
  });

  /**
   * @id TEST-M5-TDD-002
   * @verifies REQ-M5-TDD-002 REQ-M5-TDD-003
   */
  it('TEST-M5-TDD-002 appends a new scope after a complete batch',async () => {
    const complete: ChangeTddBatch={
      scopeId: 'REQ-M5-TDD-003',
      requirementIds: ['REQ-M5-TDD-003'],
      red: phase('red',10),
      implementation: phase('implementation',20),
      green: phase('green',30),
    };
    const pending: ChangeTddBatch={
      scopeId: 'REQ-M5-TDD-003#2',
      requirementIds: ['REQ-M5-TDD-003'],
      red: phase('red',40),
    };
    const { batchForRecording,nextBatchScopeId }=
      await import('../packages/analysis/src/change-evidence.js');

    expect(batchForRecording([complete],['REQ-M5-TDD-003'],'red')).toBeUndefined();
    expect(nextBatchScopeId([complete],['REQ-M5-TDD-003']))
      .toBe('REQ-M5-TDD-003#2');
    expect(batchForRecording([complete,pending],['REQ-M5-TDD-003'],'implementation'))
      .toBe(pending);
    expect(batchForRecording([complete,pending],['REQ-M5-TDD-003'],'green'))
      .toBeUndefined();
  });
});
