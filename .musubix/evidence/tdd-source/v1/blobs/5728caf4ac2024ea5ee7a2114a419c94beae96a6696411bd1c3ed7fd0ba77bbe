# @id CODE-M5-CI-NODE24-001
# @implements REQ-M5-CI-001 REQ-M5-CI-002
# @design DES-M5-CI-001 DES-M5-CI-002
name: Candidate gate

on:
  workflow_dispatch:
    inputs:
      changeId:
        description: CHANGE identifier
        required: true
        type: string
      generation:
        description: Active CHANGE generation
        required: true
        type: number
      candidateCommit:
        description: Candidate commit SHA
        required: true
        type: string
      repositoryId:
        description: Persisted musubix5 repository identity
        required: true
        type: string
      gateInputFingerprint:
        description: gate-input-fingerprint-v1 SHA-256
        required: true
        type: string

permissions:
  contents: read
  id-token: write

jobs:
  verify:
    name: ${{ matrix.os }}-node${{ matrix.node }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-latest
            os: ubuntu
            node: 24
          - runner: windows-latest
            os: windows
            node: 24
          - runner: macos-latest
            os: macos
            node: 24
    runs-on: ${{ matrix.runner }}
    env:
      CANDIDATE_COMMIT: ${{ inputs.candidateCommit }}
      CHANGE_ID: ${{ inputs.changeId }}
      GENERATION: ${{ inputs.generation }}
      GATE_INPUT_FINGERPRINT: ${{ inputs.gateInputFingerprint }}
      MATRIX_OS: ${{ matrix.os }}
      MATRIX_NODE: ${{ matrix.node }}
      REPOSITORY_ID: ${{ inputs.repositoryId }}
    steps:
      - name: Check Git LFS before checkout
        shell: bash
        run: |
          node --input-type=module <<'NODE'
          // check-lfs-tool.mjs bootstrap: repository scripts are unavailable before checkout.
          import { execFileSync } from 'node:child_process';
          let text;
          try { text = execFileSync('git', ['lfs', 'version'], {encoding:'utf8', stdio:['ignore','pipe','pipe']}); }
          catch { throw new Error('TDD_SOURCE_LFS_UNAVAILABLE: tool-missing'); }
          const v = /^git-lfs\/(\d+)\.(\d+)\.(\d+)(?:\s|$)/.exec(text);
          if (!v || +v[1] < 3 || +v[1] === 3 && (+v[2] < 4 || +v[2] === 4 && +v[3] < 1))
            throw new Error('TDD_SOURCE_LFS_UNAVAILABLE: version-unsupported');
          NODE
      # @id CODE-M5-CI-CHECKOUT-EOL-001
      # @implements REQ-M5-CI-006
      # @design DES-M5-CI-006
      - name: Disable checkout line-ending conversion
        run: git config --global core.autocrlf false
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.candidateCommit }}
          persist-credentials: false
          lfs: true
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
          cache: npm
      - name: Fetch and independently verify exact candidate LFS closure
        env:
          GH_TOKEN: ${{ github.token }}
        run: node scripts/verify-lfs-checkout.mjs .
      - run: npm ci
      - run: npm run build
      - name: Run closed verification matrix
        # @id CODE-M5-CI-MATRIX-WORKFLOW-001
        # @implements REQ-M5-CI-008
        # @design DES-M5-CI-008
        shell: bash
        run: |
          if ! node --input-type=module <<'NODE'
          import { spawnSync } from 'node:child_process';
          import { join } from 'node:path';
          import { runCandidateGateCommand, normalizeCandidateGateReport } from './dist/packages/analysis/src/candidate-gate.js';
          import { canonicalRepositoryIdentity } from './dist/packages/analysis/src/canonical.js';
          import { verifyCandidateLfsClosure, compareTrackedTree } from './dist/packages/analysis/src/workspace-manager.js';

          const run = (command, args) => spawnSync(command, args, {
            cwd: process.cwd(),
            encoding: 'utf8',
            shell: false,
          });
          const head = run('git', ['rev-parse', 'HEAD']).stdout.trim();
          const repositoryRoot = run('git', ['rev-parse', '--show-toplevel']).stdout.trim();
          if (head.toLowerCase() !== process.env.CANDIDATE_COMMIT.toLowerCase()) {
            throw new Error('Checked out commit does not match candidateCommit.');
          }
          const remote = run('git', ['config', '--get-all', 'remote.origin.url']);
          const selectedRemote = remote.stdout.split(/\r?\n/, 1)[0];
          if (remote.status !== 0
            || !repositoryRoot
            || canonicalRepositoryIdentity(selectedRemote, repositoryRoot) !== process.env.REPOSITORY_ID) {
            throw new Error(
              'RELEASE_GATE_CANDIDATE_MISMATCH: repository identity mismatch; '
              + 'release evidence producers must use the credential-free GitHub HTTPS origin.',
            );
          }
          await verifyCandidateLfsClosure(process.cwd(), head, 'local');
          const preHydration = spawnSync(process.execPath, ['scripts/verify-lfs-checkout.mjs', '.', '--verify-only'], { stdio: 'inherit' });
          const preTreeMatchesCandidate = preHydration.status === 0 && await compareTrackedTree(process.cwd(), head, 'pre');
          if (!preTreeMatchesCandidate) throw new Error('TDD_SOURCE_LFS_INVALID: worktree-integrity');
          const secrets = Object.entries(process.env)
            .filter(([name, value]) => value && /TOKEN|SECRET|PASSWORD|CREDENTIAL|PRIVATE_KEY|AUTH/i.test(name))
            .map(([, value]) => value);
          const completed = await runCandidateGateCommand({
            command: process.execPath,
            args: ['dist/packages/cli/src/main.js', 'gate', '--matrix', '--json'],
            cwd: process.cwd(), temporaryDirectory: process.env.RUNNER_TEMP,
            timeoutMs: 300_000, secrets,
          });
          await verifyCandidateLfsClosure(process.cwd(), head, 'local');
          const postHydration = spawnSync(process.execPath, ['scripts/verify-lfs-checkout.mjs', '.', '--verify-only'], { stdio: 'inherit' });
          const postTreeMatchesCandidate = postHydration.status === 0 && await compareTrackedTree(process.cwd(), head, 'post');
          await normalizeCandidateGateReport(completed, {
            resultPath: join(process.env.RUNNER_TEMP, 'candidate-gate-result.json'),
            context: {
              repositoryId: process.env.REPOSITORY_ID, changeId: process.env.CHANGE_ID,
              generation: Number(process.env.GENERATION), candidateCommit: process.env.CANDIDATE_COMMIT,
              gateInputFingerprint: process.env.GATE_INPUT_FINGERPRINT,
              job: { os: process.env.MATRIX_OS, nodeMajor: Number(process.env.MATRIX_NODE) },
            },
            preTreeMatchesCandidate, postTreeMatchesCandidate, secrets,
          });
          NODE
          then
            node .github/scripts/write-candidate-gate-runner-failure.mjs
          fi
      - name: Sign with GitHub OIDC-bound ephemeral key
        if: ${{ always() }}
        shell: bash
        run: |
          node --input-type=module <<'NODE'
          import { createHash, generateKeyPairSync, sign } from 'node:crypto';
          import { readFileSync, writeFileSync } from 'node:fs';
          import { join } from 'node:path';
          import { candidateGateFingerprintConfig } from './dist/packages/analysis/src/candidate-gate.js';

          const canonical = (value) => Array.isArray(value)
            ? `[${value.map(canonical).join(',')}]`
            : value && typeof value === 'object'
              ? `{${Object.entries(value).sort(([a], [b]) => Buffer.compare(Buffer.from(a), Buffer.from(b))).map(([key, nested]) => `${JSON.stringify(key)}:${canonical(nested)}`).join(',')}}`
              : JSON.stringify(value);
          const result = JSON.parse(readFileSync(join(process.env.RUNNER_TEMP, 'candidate-gate-result.json'), 'utf8'));
          const artifactDigest = createHash('sha256').update(`${canonical(result)}\n`).digest('hex');
          const { privateKey, publicKey } = generateKeyPairSync('ed25519');
          const publicKeyPem = publicKey.export({ type: 'spki', format: 'pem' }).toString();
          const publicKeyDer = publicKey.export({ type: 'spki', format: 'der' });
          const projection = await candidateGateFingerprintConfig(process.cwd());
          const audienceBase = projection.candidateGate.attestation.githubOidc.audience;
          const audience = `${audienceBase}#musubix3-key-sha256=${createHash('sha256').update(publicKeyDer).digest('base64url')}`;
          const requestUrl = new URL(process.env.ACTIONS_ID_TOKEN_REQUEST_URL);
          requestUrl.searchParams.set('audience', audience);
          const response = await fetch(requestUrl, {
            headers: { authorization: `Bearer ${process.env.ACTIONS_ID_TOKEN_REQUEST_TOKEN}` },
          });
          if (!response.ok) throw new Error(`OIDC token request failed: ${response.status}`);
          const token = (await response.json()).value;
          const unsigned = {
            schemaVersion: 1,
            repository: process.env.GITHUB_REPOSITORY,
            commitSha: process.env.CANDIDATE_COMMIT,
            ci: { provider: 'github', runId: process.env.GITHUB_RUN_ID },
            evidenceHeads: { candidateGate: artifactDigest },
            issuedAt: new Date().toISOString(),
            keyId: `candidate-gate-${process.env.MATRIX_OS}-node${process.env.MATRIX_NODE}-${process.env.GITHUB_RUN_ID}`,
            githubOidc: { token, publicKey: publicKeyPem },
          };
          const attestation = {
            ...unsigned,
            signature: sign(null, Buffer.from(canonical(unsigned)), privateKey).toString('base64'),
          };
          writeFileSync(
            join(process.env.RUNNER_TEMP, 'candidate-gate-envelope.json'),
            `${canonical({ schemaVersion: 1, result, attestation })}\n`,
          );
          NODE
      - uses: actions/upload-artifact@v4
        if: ${{ always() }}
        with:
          name: candidate-gate-${{ matrix.os }}-node${{ matrix.node }}
          path: ${{ runner.temp }}/candidate-gate-envelope.json
          if-no-files-found: error
      - name: Enforce terminal result
        if: ${{ always() }}
        shell: bash
        run: |
          node --input-type=module -e "import {readFileSync} from 'node:fs'; import {join} from 'node:path'; const r=JSON.parse(readFileSync(join(process.env.RUNNER_TEMP,'candidate-gate-result.json'),'utf8')); process.exit(r.status==='pass'?0:1)"
